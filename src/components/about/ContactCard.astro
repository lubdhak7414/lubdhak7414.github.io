---
import { siteConfig } from '@/site-config'

/* The contact card on About: two skies on one horizon (Dhaka on the left, the visitor on the
right), then the email, large, with a copy button, and the two profiles in small text.

Each sky is a hairline semicircle with a sun dot by day and a moon by night. The sun runs
between today's real sunrise and sunset (NOAA approximation, computed in the browser, no
network): Dhaka's own, and for the visitor those of their time zone's city (London for
Europe/London; the browser gives only the zone), which is the place their caption names. Zones
without a city (UTC) and polar days fall back to 06:00-18:00 by the clock. At night the feet
swap: the moon runs from the last sunset on the left to the next sunrise on the right, so the
words under each arc name the ends of the arc its dot is on. No times are printed under the
arcs (owner, 2026-10-26). In Dhaka's own zone only one sky shows. Without JS: Dhaka's arc without a dot and "Dhaka, UTC+6". */
const { email, github, linkedin } = siteConfig.socials
const external = { target: '_blank', rel: 'noopener noreferrer' }

// Geometry in viewBox units, one box per sky. The dots and the sunrise/sunset labels are HTML
// placed in percent of the same box, so they keep their size when the drawing scales down.
const W = 320
const HY = 120 // horizon
const H = 122
const CX = 160
const R = 100
const geometry = JSON.stringify({ W, H, HY, CX, R })
const footLeft = `left: ${((CX - R) / W) * 100}%`
const footRight = `left: ${((CX + R) / W) * 100}%`
const arc = `M ${CX - R} ${HY} A ${R} ${R} 0 0 1 ${CX + R} ${HY}`
const dome = `${arc} Z`
const halves = ['home', 'you'] as const
// A few stars inside each arc for the night, clear of the path the moon takes.
const stars = [
	[130, 70, 2.2],
	[182, 52, 1.6],
	[205, 88, 1.9],
	[112, 95, 1.4]
]
---

<div class='card' data-card data-geo={geometry}>
	<figure class='sky' data-sky>
		<div class='sky-grid'>
			{
				halves.map((who) => (
					<div class:list={['sky-half', `sky-half--${who}`]}>
						<div class='sky-art'>
							<svg viewBox={`0 0 ${W} ${H}`} aria-hidden='true' focusable='false'>
								<line
									class='sky-horizon'
									x1='0'
									y1={HY}
									x2={W}
									y2={HY}
									vector-effect='non-scaling-stroke'
								/>
								<line
									class='sky-horizon sky-horizon--wide'
									x1={-W / 2}
									y1={HY}
									x2={W * 1.5}
									y2={HY}
									vector-effect='non-scaling-stroke'
								/>
								<path class='sky-dome' d={dome} />
								<path class='sky-arc' d={arc} pathLength='1' vector-effect='non-scaling-stroke' />
								<g class='sky-stars'>
									{stars.map(([cx, cy, r]) => (
										<circle cx={cx} cy={cy} r={r} />
									))}
								</g>
							</svg>
							<span class='sky-dot' data-dot={who} aria-hidden='true'>
								<svg viewBox='2 2 20 20' focusable='false'>
									<circle class='sky-sun' cx='12' cy='12' r='8.5' />
									<path class='sky-moon' d='M21 12.79A9 9 0 1 1 11.21 3A7 7 0 0 0 21 12.79Z' />
								</svg>
							</span>
						</div>
						<p class='sky-feet' aria-hidden='true'>
							<span class='sky-foot' style={footLeft} data-foot={`${who}-start`}>
								sunrise
							</span>
							<span class='sky-foot' style={footRight} data-foot={`${who}-end`}>
								sunset
							</span>
						</p>
						<p class='sky-cap'>
							{who === 'home' ? (
								<span class='sky-name'>Dhaka</span>
							) : (
								<span class='sky-name'>
									You <span data-city />
								</span>
							)}
							<span class='sky-time' data-time={who} />
						</p>
					</div>
				))
			}
		</div>
		<figcaption class='sky-diff' data-diff>Dhaka, UTC+6</figcaption>
	</figure>

	<div class='reach'>
		<p class='reach-lead'>
			Email is the best way to reach me. Send your site's address and what you need, and I'll tell
			you if I can help.
		</p>
		<div class='reach-mail'>
			<a class='reach-addr' href={`mailto:${email}`} set:text={email} />
			<button
				type='button'
				class='reach-copy'
				data-copy={email}
				aria-label='Copy email address'
				hidden
			>
				<svg class='reach-icon' viewBox='0 0 24 24' aria-hidden='true' focusable='false'>
					<g class='reach-icon-copy'>
						<rect x='8' y='8' width='12' height='12' rx='2'></rect>
						<path d='M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2'></path>
					</g>
					<path class='reach-icon-check' d='M5 12.5l4.5 4.5L19 7.5'></path>
				</svg>
				<span class='reach-copy-text' data-copy-text>Copy</span>
			</button>
		</div>
		<span class='sr-only' role='status' aria-live='polite' data-copy-status></span>
		<p class='reach-reply'>I usually reply within a day.</p>
		<p class='reach-else'>
			<span class='reach-else-key'>also</span>
			<a href={github} {...external} set:text='GitHub' />
			<a href={linkedin} {...external} set:text='LinkedIn' />
		</p>
	</div>
</div>

<script>
	import { coordsOf } from '../../data/zoneCoords'

	const HOME = 'Asia/Dhaka'
	const DHAKA: [number, number] = [23.81, 90.41]
	const RAD = Math.PI / 180
	const DAY = 86400000

	type Geo = { W: number; H: number; HY: number; CX: number; R: number }
	type Parts = { y: number; mo: number; d: number; h: number; mi: number; s: number }

	const pad = (n: number) => String(n).padStart(2, '0')
	const mod = (n: number, m: number) => ((n % m) + m) % m
	const clamp = (n: number) => Math.min(1, Math.max(0, n))

	// Wall-clock fields in a zone (the visitor's own when `timeZone` is undefined).
	function partsIn(timeZone?: string) {
		const f = new Intl.DateTimeFormat('en-GB', {
			timeZone,
			hourCycle: 'h23',
			year: 'numeric',
			month: 'numeric',
			day: 'numeric',
			hour: 'numeric',
			minute: 'numeric',
			second: 'numeric'
		})
		return (at: Date): Parts => {
			const p: Record<string, number> = {}
			for (const { type, value } of f.formatToParts(at)) p[type] = Number(value)
			return { y: p.year, mo: p.month, d: p.day, h: p.hour % 24, mi: p.minute, s: p.second }
		}
	}
	// Minutes east of UTC for a zone at an instant, from the zone's own wall clock.
	function offsetOf(parts: Parts, at: Date) {
		const wall = Date.UTC(parts.y, parts.mo - 1, parts.d, parts.h, parts.mi, parts.s)
		return Math.round((wall - Math.floor(at.getTime() / 1000) * 1000) / 60000)
	}
	// "5 h", "5 h 30 min", "45 min"
	function span(minutes: number) {
		const h = Math.floor(minutes / 60)
		const m = minutes % 60
		return [h ? `${h} h` : '', m ? `${m} min` : ''].filter(Boolean).join(' ')
	}
	function utcLabel(offset: number) {
		const sign = offset < 0 ? '-' : '+'
		const abs = Math.abs(offset)
		return `UTC${sign}${Math.floor(abs / 60)}${abs % 60 ? `:${pad(abs % 60)}` : ''}`
	}
	// Old IANA names some browsers still report.
	const renamed: Record<string, string> = {
		Calcutta: 'Kolkata',
		Saigon: 'Ho Chi Minh',
		Katmandu: 'Kathmandu',
		Rangoon: 'Yangon',
		Kiev: 'Kyiv'
	}
	// "Europe/London" -> "London", "America/Argentina/Buenos_Aires" -> "Buenos Aires".
	function placeOf(zone: string | undefined, offset: number) {
		if (!zone || !zone.includes('/') || zone.startsWith('Etc/')) return utcLabel(offset)
		const city = zone.slice(zone.lastIndexOf('/') + 1)
		return renamed[city] ?? city.replace(/_/g, ' ')
	}

	// NOAA general solar position approximation: sunrise and sunset instants at a place for a
	// calendar date there (zenith 90.833 degrees for refraction and the sun's disc), given the
	// zone's offset in minutes. The solar noon is the one nearest local noon of that date, so it
	// holds where the clock is far from the longitude too (Samoa, Kiribati). NaN when the sun
	// doesn't rise or set that day.
	function sunTimes([lat, lon]: [number, number], y: number, m: number, d: number, off: number) {
		const midnight = Date.UTC(y, m - 1, d)
		const doy = Math.round((midnight - Date.UTC(y, 0, 1)) / DAY) + 1
		const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0
		const g = ((2 * Math.PI) / (leap ? 366 : 365)) * (doy - 1)
		const eqtime =
			229.18 *
			(0.000075 +
				0.001868 * Math.cos(g) -
				0.032077 * Math.sin(g) -
				0.014615 * Math.cos(2 * g) -
				0.040849 * Math.sin(2 * g))
		const decl =
			0.006918 -
			0.399912 * Math.cos(g) +
			0.070257 * Math.sin(g) -
			0.006758 * Math.cos(2 * g) +
			0.000907 * Math.sin(2 * g) -
			0.002697 * Math.cos(3 * g) +
			0.00148 * Math.sin(3 * g)
		const ha =
			Math.acos(
				Math.cos(90.833 * RAD) / (Math.cos(lat * RAD) * Math.cos(decl)) -
					Math.tan(lat * RAD) * Math.tan(decl)
			) / RAD
		const noon = midnight + (720 - 4 * lon - eqtime) * 60000
		const shift = Math.round((midnight - off * 60000 + DAY / 2 - noon) / DAY) * DAY
		return { rise: noon + shift - 4 * ha * 60000, set: noon + shift + 4 * ha * 60000 }
	}

	// Where the sun or moon is on the arc at instant t, for a place, its wall-clock date and its
	// offset: by day from sunrise to sunset, by night from the last sunset to the next sunrise
	// (looked for across three days, since a night can end or start on another date). Without a
	// place, or next to a polar day or night, 06:00-18:00 by the clock.
	function skyAt(t: number, p: Parts, where: [number, number] | undefined, off: number) {
		const clock = () => {
			const m = p.h * 60 + p.mi
			return m >= 360 && m < 1080
				? { f: (m - 360) / 720, night: false }
				: { f: mod(m - 1080, 1440) / 720, night: true }
		}
		if (!where) return clock()
		const day = (k: number) => {
			const o = new Date(Date.UTC(p.y, p.mo - 1, p.d) + k * DAY)
			return sunTimes(where, o.getUTCFullYear(), o.getUTCMonth() + 1, o.getUTCDate(), off)
		}
		const days = [day(-1), day(0), day(1)]
		if (days.some((e) => Number.isNaN(e.rise))) return clock()
		const today = days[1]
		if (t >= today.rise && t <= today.set) {
			return { f: (t - today.rise) / (today.set - today.rise), night: false }
		}
		const from = Math.max(...days.map((e) => e.set).filter((x) => x <= t))
		const to = Math.min(...days.map((e) => e.rise).filter((x) => x > t))
		if (!Number.isFinite(from) || !Number.isFinite(to)) return clock()
		return { f: (t - from) / (to - from), night: true }
	}

	let teardown: (() => void) | undefined

	function setup() {
		teardown?.()
		teardown = undefined
		const card = document.querySelector<HTMLElement>('[data-card]')
		if (!card) return
		const sky = card.querySelector<HTMLElement>('[data-sky]')
		const geo = JSON.parse(card.dataset.geo ?? '{}') as Geo
		const q = (sel: string) => card.querySelector<HTMLElement>(sel)
		const homeDot = q('[data-dot="home"]')
		const youDot = q('[data-dot="you"]')
		const homeTime = q('[data-time="home"]')
		const youTime = q('[data-time="you"]')
		const cityEl = q('[data-city]')
		const diffEl = q('[data-diff]')
		const controller = new AbortController()
		const { signal } = controller
		let timer: number | undefined
		let frame: number | undefined
		let reset: number | undefined

		// ---- Two skies ----
		if (sky && homeDot && youDot && homeTime && youTime && cityEl && diffEl) {
			const zone = Intl.DateTimeFormat().resolvedOptions().timeZone
			const home = partsIn(HOME)
			const you = partsIn(zone)
			const where = coordsOf(zone)
			// f in [0, 1]: from the left foot of the arc over the top to the right foot.
			const onArc = (f: number): [number, number] => {
				const t = Math.PI * (1 - clamp(f))
				return [geo.CX + geo.R * Math.cos(t), geo.HY - geo.R * Math.sin(t)]
			}
			const set = (el: HTMLElement | null, text: string) => {
				if (el && el.textContent !== text) el.textContent = text
			}
			const move = (dot: HTMLElement, f: number) => {
				const [x, y] = onArc(f)
				dot.style.left = `${((x / geo.W) * 100).toFixed(3)}%`
				dot.style.top = `${((y / geo.H) * 100).toFixed(3)}%`
			}
			const targets = new Map<HTMLElement, number>()
			// The dot on the arc, the stars by night, and the words under the feet (swapped at night).
			const place = (who: string, dot: HTMLElement, { f, night }: ReturnType<typeof skyAt>) => {
				targets.set(dot, f)
				// At sunrise and sunset the dot wraps from one foot to the other: jump, don't slide.
				const phase = night ? 'night' : 'day'
				const wraps = dot.dataset.phase !== undefined && dot.dataset.phase !== phase
				if (wraps) dot.style.transition = 'none'
				move(dot, f)
				dot.dataset.phase = phase
				// How lit the sky is, 0 to 1: the sun lights the whole arc at sunrise and it fades over
				// the last fifth of the day; the moonlight comes and goes gently at both ends of the night.
				const glow = night ? Math.min(1, f / 0.15, (1 - f) / 0.15) : Math.min(1, (1 - f) / 0.2)
				dot.closest<HTMLElement>('.sky-half')?.style.setProperty('--glow', clamp(glow).toFixed(3))
				if (wraps) {
					void dot.offsetWidth
					dot.style.transition = ''
				}
				dot.closest('.sky-half')?.toggleAttribute('data-night', night)
				set(q(`[data-foot="${who}-start"]`), night ? 'sunset' : 'sunrise')
				set(q(`[data-foot="${who}-end"]`), night ? 'sunrise' : 'sunset')
			}

			let last = ''
			const tick = () => {
				const at = new Date()
				const h = home(at)
				const y = you(at)
				const key = `${h.d} ${h.h}:${h.mi}|${y.h}:${y.mi}`
				if (key === last) return
				last = key

				const homeOff = offsetOf(h, at)
				const youOff = zone ? offsetOf(y, at) : -at.getTimezoneOffset()
				const ahead = homeOff - youOff
				sky.toggleAttribute('data-one', ahead === 0)
				set(homeTime, `${pad(h.h)}:${pad(h.mi)}`)
				set(youTime, `${pad(y.h)}:${pad(y.mi)}`)
				set(cityEl, `(${placeOf(zone, youOff)})`)
				set(
					diffEl,
					ahead === 0
						? 'Same time as you'
						: `Dhaka is ${span(Math.abs(ahead))} ${ahead > 0 ? 'ahead of' : 'behind'} you`
				)

				const t = at.getTime()
				place('home', homeDot, skyAt(t, h, DHAKA, homeOff))
				place('you', youDot, skyAt(t, y, where, youOff))
			}

			tick()
			sky.dataset.ready = ''
			// On arrival the arcs draw in (CSS) and each dot rises from its left foot to where it
			// is now. Dots slide between minutes only after that.
			const start = performance.now()
			const rise = (now: number) => {
				const k = Math.min(1, (now - start) / 1100)
				const eased = 1 - (1 - k) ** 3
				for (const [dot, f] of targets) move(dot, f * eased)
				if (k < 1) {
					frame = window.requestAnimationFrame(rise)
				} else {
					void sky.offsetWidth
					sky.dataset.live = ''
				}
			}
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				sky.dataset.live = ''
			} else {
				for (const dot of targets.keys()) move(dot, 0)
				frame = window.requestAnimationFrame(rise)
			}
			timer = window.setInterval(tick, 1000)
		}

		// ---- Copy the address ----
		const button = card.querySelector<HTMLButtonElement>('[data-copy]')
		const label = q('[data-copy-text]')
		const status = q('[data-copy-status]')
		if (button && navigator.clipboard?.writeText) {
			button.hidden = false
			button.addEventListener(
				'click',
				async () => {
					try {
						await navigator.clipboard.writeText(button.dataset.copy ?? '')
					} catch {
						if (status) status.textContent = 'Could not copy. Select the address instead.'
						return
					}
					button.dataset.done = ''
					if (label) label.textContent = 'Copied'
					if (status) status.textContent = 'Email address copied.'
					window.clearTimeout(reset)
					reset = window.setTimeout(() => {
						delete button.dataset.done
						if (label) label.textContent = 'Copy'
						if (status) status.textContent = ''
					}, 2000)
				},
				{ signal }
			)
		}

		teardown = () => {
			controller.abort()
			window.clearInterval(timer)
			window.clearTimeout(reset)
			if (frame !== undefined) window.cancelAnimationFrame(frame)
		}
	}

	document.addEventListener('astro:page-load', setup)
	document.addEventListener('astro:before-swap', () => {
		teardown?.()
		teardown = undefined
	})
</script>

<style>
	.card {
		/* The sun's own colour, used only by the skies. */
		--sun: #e09b0b;
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: 6px;
	}

	/* ---------- Two skies ---------- */
	.sky-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		/* The shared horizon runs past each box; clipped to the card here. */
		overflow: hidden;
	}
	.sky-art {
		position: relative;
	}
	.sky-art > svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.sky-horizon {
		stroke: var(--line-strong);
		stroke-width: 1;
	}
	.sky-horizon--wide {
		display: none;
	}
	/* The sky lights up with the sun: by day the arc turns the sun's colour and the dome under it
	   takes a warm wash; by night the moon lends both a cool grey. --glow (0-1) comes from the
	   script; without it the arc is the plain grey line. */
	.sky-arc {
		fill: none;
		stroke: color-mix(in srgb, var(--sun) calc(var(--glow, 0) * 100%), var(--faint));
		stroke-width: 1;
		transition: stroke 1.2s ease;
	}
	.sky-half[data-night] .sky-arc {
		stroke: color-mix(in srgb, var(--muted) calc(var(--glow, 0) * 100%), var(--faint));
	}
	/* A browser without color-mix keeps the plain grey arc rather than none. */
	@supports not (stroke: color-mix(in srgb, red calc(0.5 * 100%), blue)) {
		.sky-arc,
		.sky-half[data-night] .sky-arc {
			stroke: var(--faint);
		}
	}
	.sky-dome {
		fill: var(--sun);
		opacity: calc(var(--glow, 0) * 0.12);
		transition:
			opacity 1.2s ease,
			fill 1.2s ease;
	}
	.sky-half[data-night] .sky-dome {
		fill: var(--muted);
		opacity: calc(var(--glow, 0) * 0.06);
	}
	/* With scripting the arc waits hidden for the draw-in, so it doesn't show, vanish and redraw. */
	@media (scripting: enabled) {
		.sky:not([data-ready]) .sky-arc {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
		}
	}
	.sky[data-ready] .sky-arc {
		animation: sky-draw 0.9s cubic-bezier(0.33, 1, 0.68, 1) both;
	}
	@keyframes sky-draw {
		from {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
		}
		to {
			stroke-dasharray: 1;
			stroke-dashoffset: 0;
		}
	}
	/* Stars come out at night and twinkle slowly, each on its own beat. */
	.sky-stars {
		fill: var(--faint);
		opacity: 0;
		transition: opacity 1.2s ease;
	}
	.sky-half[data-night] .sky-stars {
		opacity: 1;
	}
	.sky-stars circle {
		animation: sky-twinkle 3.6s ease-in-out infinite;
	}
	.sky-stars circle:nth-child(2) {
		animation-duration: 4.4s;
		animation-delay: -1.3s;
	}
	.sky-stars circle:nth-child(3) {
		animation-duration: 5.2s;
		animation-delay: -2.6s;
	}
	.sky-stars circle:nth-child(4) {
		animation-duration: 4s;
		animation-delay: -0.7s;
	}
	@keyframes sky-twinkle {
		0%,
		100% {
			opacity: 0.35;
		}
		50% {
			opacity: 1;
		}
	}

	.sky-dot {
		position: absolute;
		width: 0.875rem;
		height: 0.875rem;
		margin: -0.4375rem 0 0 -0.4375rem;
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.sky-dot svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.sky-sun {
		fill: var(--sun);
	}
	/* A soft halo round the sun. */
	.sky-dot[data-phase='day'] svg {
		filter: drop-shadow(0 0 3px color-mix(in srgb, var(--sun) 70%, transparent));
	}
	.sky-moon {
		fill: var(--muted);
	}
	/* At sunrise and sunset the moon and sun turn into each other (not on arrival). */
	.sky-sun,
	.sky-moon {
		transform-box: fill-box;
		transform-origin: center;
	}
	.sky[data-live] :is(.sky-sun, .sky-moon) {
		transition:
			opacity 0.5s ease,
			transform 0.6s ease;
	}
	.sky-dot:not([data-phase='night']) .sky-moon {
		opacity: 0;
		transform: rotate(-60deg) scale(0.4);
	}
	.sky-dot[data-phase='night'] .sky-sun {
		opacity: 0;
		transform: scale(0.4);
	}
	.sky[data-ready] .sky-dot {
		opacity: 1;
	}
	.sky[data-live] .sky-dot {
		transition:
			opacity 0.4s ease,
			left 0.6s ease,
			top 0.6s ease;
	}

	/* Sunrise and sunset under the feet of Dhaka's arc. */
	.sky-feet {

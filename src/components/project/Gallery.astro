---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

export interface Slide {
	src: ImageMetadata
	alt: string
	/** The section of the write-up the screenshot belongs to, if it appears in the text. */
	section?: { slug: string; n: number; text: string } | undefined
}

interface Props {
	slides: Slide[]
}

const { slides } = Astro.props
const pad = (n: number) => String(n).padStart(2, '0')
---

{
	/* The case study's real screenshots, big. One stage; with more than one, thumbnails switch
it (buttons, arrow keys inside the strip). Without JavaScript every screenshot stacks with its
caption, so nothing hides behind a script. */
}
{
	slides.length > 0 && (
		<div class='gal' data-gal>
			<div class='gal-stage'>
				{slides.map(({ src, alt, section }, i) => (
					<figure class='gal-slide' data-active={i === 0 ? '' : undefined}>
						<div class='gal-frame'>
							<Image
								src={src}
								alt={alt}
								widths={[704, 1056, 1408]}
								sizes='(min-width: 960px) 704px, calc(100vw - 2.5rem)'
								loading={i === 0 ? 'eager' : 'lazy'}
								fetchpriority={i === 0 ? 'high' : undefined}
								decoding='async'
							/>
						</div>
						<figcaption class='gal-cap'>
							{slides.length > 1 && <span class='gal-n' set:text={`${i + 1} / ${slides.length}`} />}
							<span class='gal-alt' set:text={alt} />
							{section && (
								<a
									class='gal-sec'
									href={`#${section.slug}`}
									set:text={`In ${pad(section.n)} ${section.text} ↓`}
								/>
							)}
						</figcaption>
					</figure>
				))}
			</div>
			{slides.length > 1 && (
				<div class='gal-thumbs' role='group' aria-label='Screenshots'>
					{slides.map(({ src, alt }, i) => (
						<button
							type='button'
							class='gal-thumb'
							aria-pressed={i === 0 ? 'true' : 'false'}
							aria-label={`Screenshot ${i + 1} of ${slides.length}: ${alt}`}
						>
							<Image src={src} alt='' widths={[160, 320]} sizes='112px' loading='lazy' />
						</button>
					))}
				</div>
			)}
		</div>
	)
}

<script>
	document.addEventListener('astro:page-load', () => {
		for (const gal of document.querySelectorAll<HTMLElement>('[data-gal]')) {
			const slides = Array.from(gal.querySelectorAll<HTMLElement>('.gal-slide'))
			const thumbs = Array.from(gal.querySelectorAll<HTMLButtonElement>('.gal-thumb'))
			if (thumbs.length < 2) continue
			gal.classList.add('is-live')
			let current = 0
			const show = (i: number, focus = false) => {
				current = (i + slides.length) % slides.length
				slides.forEach((s, j) => s.toggleAttribute('data-active', j === current))
				thumbs.forEach((t, j) => t.setAttribute('aria-pressed', String(j === current)))
				if (focus) thumbs[current]?.focus()
			}
			thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)))
			// Inside the strip the arrow keys move between screenshots (and don't flip the page).
			gal.querySelector('.gal-thumbs')?.addEventListener('keydown', (e) => {
				const ev = e as KeyboardEvent
				if (ev.key !== 'ArrowLeft' && ev.key !== 'ArrowRight') return
				ev.preventDefault()
				ev.stopPropagation()
				show(current + (ev.key === 'ArrowRight' ? 1 : -1), true)
			})
		}
	})
</script>

---
import type { CollectionEntry } from 'astro:content'

import ProjectLinks from './ProjectLinks.astro'
import Shot from './Shot.astro'

interface Props {
	project: CollectionEntry<'project'>
	eager?: boolean
}

const { project, eager = false } = Astro.props
const { data } = project
const name = `${data.draft ? '(Draft) ' : ''}${data.name ?? data.title}`
const stack = (data.facts.stack ?? []).slice(0, 4).join(' · ')
---

{
	/* Pictures view: screenshot, name, two lines of summary, stack and links. The name's link
stretches over the whole tile; the code/live/store links sit above it, so nothing nests. */
}
<li class='tile'>
	<Shot
		project={project}
		widths={[360, 560, 720, 1080]}
		sizes='(min-width: 960px) 340px, (min-width: 640px) 45vw, 100vw'
		eager={eager}
	/>
	<h3 class='tile-name'>
		<a class='tile-link' href={`/projects/${project.id}/`} set:text={name} />
	</h3>
	<p class='tile-text'>{data.description}</p>
	<p class='tile-foot'>
		{stack && <span class='tile-stack'>{stack}</span>}
		<ProjectLinks project={project} />
	</p>
</li>

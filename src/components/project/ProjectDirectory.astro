---
import { getAllProjects } from '@/utils'

interface Props {
	/** The project being read; it takes the accent and aria-current. */
	current: string
	/** `side`: in the sidebar (wide screens). `page`: at the end of the page (narrow ones). */
	variant: 'side' | 'page'
}

const { current, variant } = Astro.props
const projects = await getAllProjects()
const label = variant === 'side' ? 'Projects' : 'All projects'
---

{/* Every project, short names only; the one being read is marked. */}
<nav class:list={['pdir', `pdir--${variant}`]} aria-label={label}>
	<p class='label'>{label}</p>
	<ul>
		{
			projects.map((project) => (
				<li>
					<a
						href={`/projects/${project.id}/`}
						aria-current={project.id === current ? 'page' : undefined}
						set:text={project.data.name ?? project.data.title}
					/>
				</li>
			))
		}
	</ul>
</nav>

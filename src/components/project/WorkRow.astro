---
import type { CollectionEntry } from 'astro:content'

import ProjectIcon from './ProjectIcon.astro'
import ProjectLinks from './ProjectLinks.astro'
import { shorten, typeset } from '@/utils/typeset'

interface Props {
	project: CollectionEntry<'project'>
}

const { project } = Astro.props
const { data } = project
const name = `${data.draft ? '(Draft) ' : ''}${typeset(data.name ?? data.title)}`
// Client work says so, the same way on every row; the client's name is on the project page.
const context = data.facts.client ? 'Client project' : undefined
const stack = (data.facts.stack ?? []).slice(0, 4).join(' · ')
// Phones show three lines at most: a summary cut in code at a sentence, clause or word, never
// mid-word with a doubled stop ("edits....") as a CSS clamp would.
const text = typeset(data.description)
const short = typeset(shorten(data.description))
---

{
	/* One case study: the name and who it was for, the summary, then the stack, the
code/live/store links and an arrow. The name's link stretches over the row; the other links
sit above it, so nothing nests. */
}
<li class='prow'>
	<ProjectIcon id={project.id} />
	<div class='prow-body'>
		<p class='prow-head'>
			<a class='prow-name' href={`/projects/${project.id}/`} set:text={name} />
			{/* Phones: the arrow sits on the name's line (the foot row is hidden there). */}
			<span class='prow-go prow-go--head' aria-hidden='true'>→</span>
			{context && <span class='prow-ctx' set:text={context} />}
		</p>
		<p class='prow-text'>
			<span class:list={[{ 'prow-full': short !== text }]} set:text={text} />
			{short !== text && <span class='prow-short' set:text={short} />}
		</p>
		<p class='prow-foot'>
			{stack && <span class='prow-stack'>{stack}</span>}
			<ProjectLinks project={project} />
			<span class='prow-go' aria-hidden='true'>→</span>
		</p>
	</div>
</li>

---
import type { Series } from '@/utils'
import { isoDate } from '@/utils'
import { typeset } from '@/utils/typeset'

interface Props {
	series: Series
}

const { series } = Astro.props
const first = series.parts[0]!
---

{/* A whole series as one Writing row: date | name, one line, "13 notes" in mono. */}
<li class='row'>
	<a class='row-link' href={`/series/${series.slug}/`}>
		<time class='row-date' datetime={isoDate(first.data.publishDate)}>
			{isoDate(first.data.publishDate)}
		</time>
		<span class='row-body'>
			<span class='row-title'>{first.data.draft && '(Draft) '}{typeset(series.title)}</span>
			<span class='row-text' set:text={typeset(series.about)} />
			<span class='row-meta'>{`Series · ${series.parts.length} notes`}</span>
		</span>
	</a>
</li>

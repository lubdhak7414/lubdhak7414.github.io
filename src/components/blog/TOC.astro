---
import type { MarkdownHeading } from 'astro'
import { generateToc } from '@/utils'

interface Props {
	headings: MarkdownHeading[]
	/** `sidebar`: the contents list in the sidebar (wide screens). `drawer`: the collapsible
	 * list above the text on narrow screens. */
	variant: 'sidebar' | 'drawer'
	label?: string
}

const { headings, variant, label = 'Contents' } = Astro.props

// h2 sections only. A post may have headings yet no h2; render nothing
// then rather than an empty shell.
const toc = generateToc(headings)
const pad = (n: number) => String(n).padStart(2, '0')
const start = `01/${pad(toc.length)}`
---

{
	toc.length > 0 &&
		(variant === 'sidebar' ? (
			<nav class='toc' aria-label={label}>
				<p class='label toc-head'>
					<span set:text={label} />
					<span class='toc-count' aria-hidden='true' set:text={start} />
				</p>
				<ol>
					{toc.map(({ slug, text }) => (
						<li>
							<a href={`#${slug}`}>{text}</a>
						</li>
					))}
				</ol>
			</nav>
		) : (
			<details class='toc-mobile'>
				<summary>
					<span set:text={label} />
					<span class='toc-count' aria-hidden='true' set:text={start} />
				</summary>
				<ol>
					{toc.map(({ slug, text }) => (
						<li>
							<a href={`#${slug}`}>{text}</a>
						</li>
					))}
				</ol>
			</details>
		))
}

<script>
	// Scrollspy (reference logic): on scroll, throttled to one update per frame, mark the
	// last section whose heading has passed 30% of the viewport, and force the last item
	// once the page is scrolled to the bottom (on tall screens the final section can't
	// reach the line). Position-based rather than IntersectionObserver-only, which skips
	// sections when scrolling up.
	;(() => {
		const links = document.querySelectorAll<HTMLAnchorElement>('.toc a')
		if (!links.length) return
		const sections = Array.from(links, (a) =>
			document.getElementById(decodeURIComponent(a.hash.slice(1)))
		)
		const counts = document.querySelectorAll<HTMLElement>('.toc-count')
		let ticking = false

		function update() {
			ticking = false
			const line = window.innerHeight * 0.3
			let current = 0
			sections.forEach((s, i) => {
				if (s && s.getBoundingClientRect().top <= line) current = i
			})
			if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
				current = sections.length - 1
			}
			links.forEach((a, i) => a.classList.toggle('active', i === current))
			const text = `${String(current + 1).padStart(2, '0')}/${String(sections.length).padStart(2, '0')}`
			counts.forEach((c) => {
				if (c.textContent === text) return
				c.textContent = text
				c.classList.remove('tick')
				void c.offsetWidth
				c.classList.add('tick')
			})
		}

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true
					requestAnimationFrame(update)
				}
			},
			{ passive: true }
		)
		window.addEventListener('resize', update)
		update()
	})()
</script>

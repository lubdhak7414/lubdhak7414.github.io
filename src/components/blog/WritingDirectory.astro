---
import { getAllPosts, isoDate, sortByPublishDate, writingItems } from '@/utils'

interface Props {
	/** The article being read; it takes the accent and aria-current. */
	current: string
}

const { current } = Astro.props
const posts = sortByPublishDate(await getAllPosts())
// A series is one line (to its hub), marked when the article being read is one of its parts.
const items = writingItems(posts)
const currentSeries = posts.find((post) => post.id === current)?.data.series
---

{
	/* Every article, newest first, the one being read marked: the writing twin of the
case-study directory. Sidebar only. */
}
<nav class='pdir pdir--side pdir--writing' aria-label='Writing'>
	<p class='label'>Writing</p>
	<ul>
		{
			items.map((item) =>
				item.kind === 'series' ? (
					<li>
						<a
							href={`/series/${item.series.slug}/`}
							aria-current={item.series.name === currentSeries ? 'page' : undefined}
						>
							<span
								class='pdir-date'
								set:text={`${isoDate(item.series.parts[0]!.data.publishDate).slice(0, 7)} · ${item.series.parts.length} parts`}
							/>
							<span set:text={item.series.name} />
						</a>
					</li>
				) : (
					<li>
						<a
							href={`/blog/${item.entry.id}/`}
							aria-current={item.entry.id === current ? 'page' : undefined}
						>
							<span class='pdir-date' set:text={isoDate(item.entry.data.publishDate).slice(0, 7)} />
							<span set:text={item.entry.data.title} />
						</a>
					</li>
				)
			)
		}
	</ul>
</nav>

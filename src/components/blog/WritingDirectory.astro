---
import { getAllPosts, isoDate, sortByPublishDate } from '@/utils'

interface Props {
	/** The article being read; it takes the accent and aria-current. */
	current: string
}

const { current } = Astro.props
const posts = sortByPublishDate(await getAllPosts())
---

{
	/* Every article, newest first, the one being read marked: the writing twin of the
case-study directory. Sidebar only. */
}
<nav class='pdir pdir--side pdir--writing' aria-label='Writing'>
	<p class='label'>Writing</p>
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`} aria-current={post.id === current ? 'page' : undefined}>
						<span class='pdir-date' set:text={isoDate(post.data.publishDate).slice(0, 7)} />
						<span set:text={post.data.title} />
					</a>
				</li>
			))
		}
	</ul>
</nav>

---
import type { Entry } from '@/utils'
import { entryHref, isoDate } from '@/utils'

interface Props {
	entry: Entry
}

const { entry } = Astro.props
const { data } = entry
const isProject = entry.collection === 'project'
// Writing prints its ISO date; projects (on tag pages) print no date, like the work list,
// and their stack.
const meta = isProject ? (entry.data.facts.stack ?? []).slice(0, 4).join(' · ') : ''
---

{/* Date | title and summary (projects add their stack in mono). */}
<li class='row'>
	<a class='row-link' href={entryHref(entry)}>
		{
			isProject ? (
				<span class='row-date'>project</span>
			) : (
				<time class='row-date' datetime={isoDate(data.publishDate)}>
					{isoDate(data.publishDate)}
				</time>
			)
		}
		<span class='row-body'>
			<span class='row-title'>{data.draft && '(Draft) '}{data.title}</span>
			<span class='row-text'>{data.description}</span>
			{meta && <span class='row-meta'>{meta}</span>}
		</span>
	</a>
</li>

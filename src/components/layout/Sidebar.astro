---
import { Image } from 'astro:assets'
import avatar from '@/assets/face.png'

import ContactList from '@/components/layout/ContactList.astro'
import Footer from '@/components/layout/Footer.astro'
import { getAllPosts, getAllProjects } from '@/utils'
import { siteConfig } from '@/site-config'

export type Section = 'home' | 'about' | 'work' | 'writing' | 'tools' | 'error'

interface Props {
	page: Section
	/** Case studies and articles: one path line back home instead of the identity block. */
	reading?: boolean
}

const { page, reading = false } = Astro.props
// The name is the page's h1 only where the page is about the person.
const NameTag = page === 'home' || page === 'about' ? 'h1' : 'p'
// Home and the section pages (work, writing, about, tools) carry the same identity block:
// photo, name, bio, contacts and the site nav. Case studies and articles get one path line
// back home ("saf1.me / work"); their section list sits right under it.
const full = !reading
const host = new URL(siteConfig.url).host
const here = Astro.url.pathname
const sections: Partial<Record<Section, { href: string; label: string }>> = {
	work: { href: '/projects/', label: 'work' },
	writing: { href: '/blog/', label: 'writing' },
	tools: { href: '/tools/', label: 'tools' }
}
const section = sections[page]

const counts = {
	work: (await getAllProjects()).length,
	writing: (await getAllPosts()).length
}
const nav = [
	{
		href: '/projects/',
		label: 'Work',
		n: counts.work,
		on: page === 'work'
	},
	{ href: '/blog/', label: 'Writing', n: counts.writing, on: page === 'writing' },
	{ href: '/about/', label: 'About', on: page === 'about' },
	{ href: '/tools/', label: 'Tools', on: page === 'tools' }
]
---

{
	/* Left column on every page: who and where to go (home and about), or one line back to the
home page (every other page), then whatever the page adds (slots). */
}
<aside class='side'>
	{
		full ? (
			<>
				<a class='id' href='/'>
					<Image class='id-photo' src={avatar} alt='' width={96} height={96} loading='eager' />
					<div class='id-text'>
						<NameTag class='id-name'>{siteConfig.author}</NameTag>
						<p class='id-role'>{`${siteConfig.role} · ${siteConfig.location}`}</p>
					</div>
				</a>
				<p class='side-bio'>{siteConfig.bio}</p>
				<ContactList />
				<nav class='nav' aria-label='Site'>
					<ul>
						{nav.map(({ href, label, n, on }) => (
							<li>
								<a href={href} aria-current={on ? 'page' : undefined}>
									<span>{label}</span>
									{n !== undefined && <span class='nav-n'>{n}</span>}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</>
		) : (
			<nav class='crumb' aria-label='Site'>
				<a href='/' set:text={host} />
				{section && (
					<>
						<span class='crumb-sep' aria-hidden='true'>
							/
						</span>
						<a
							href={section.href}
							aria-current={here === section.href ? 'page' : undefined}
							set:text={section.label}
						/>
					</>
				)}
			</nav>
		)
	}
	<slot />
	<Footer variant='side' />
</aside>

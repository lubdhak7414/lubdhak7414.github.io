---
import { Image } from 'astro:assets'
import avatar from '@/assets/face.png'

import Footer from '@/components/layout/Footer.astro'
import { getAllPosts, getAllProjects } from '@/utils'
import { siteConfig } from '@/site-config'

export type Section = 'home' | 'about' | 'work' | 'writing' | 'tools' | 'error'

interface Props {
	page: Section
	/** `site`: identity, the page's intro slot, the site nav. `project`: a compact identity
	 * line and a one-line nav, for case studies and articles, whose slot carries the
	 * directory of its section and the contents. */
	variant?: 'site' | 'project'
}

const { page, variant = 'site' } = Astro.props
// The name is the page's h1 only where the page is about the person.
const NameTag = page === 'home' || page === 'about' ? 'h1' : 'p'
const compact = variant === 'project'
const back =
	page === 'writing'
		? { href: '/blog/', label: '← All writing' }
		: { href: '/#work', label: '← All case studies' }

const counts = {
	work: (await getAllProjects()).length,
	writing: (await getAllPosts()).length
}
const nav = [
	{
		href: page === 'home' ? '#work' : '/#work',
		label: 'Work',
		n: counts.work,
		on: page === 'work'
	},
	{ href: '/blog/', label: 'Writing', n: counts.writing, on: page === 'writing' },
	{ href: '/about/', label: 'About', on: page === 'about' },
	{ href: '/tools/', label: 'Tools', on: page === 'tools' }
]
---

{/* Left column on every page: who, where to go, and whatever the page adds (slots). */}
<aside class:list={['side', compact && 'side--project']}>
	<a class:list={['id', compact && 'id--compact']} href='/'>
		<Image
			class='id-photo'
			src={avatar}
			alt=''
			width={compact ? 64 : 96}
			height={compact ? 64 : 96}
			loading='eager'
		/>
		<div class='id-text'>
			<NameTag class='id-name'>{siteConfig.author}</NameTag>
			<p class='id-role'>{`${siteConfig.role} · ${siteConfig.location}`}</p>
		</div>
	</a>
	<slot name='intro' />
	{
		compact ? (
			<>
				<nav class='navline' aria-label='Site'>
					<ul>
						{nav.map(({ href, label, on }) => (
							<li>
								<a href={href} aria-current={on ? 'page' : undefined} set:text={label} />
							</li>
						))}
					</ul>
				</nav>
				<a class='side-back' href={back.href} set:text={back.label} />
			</>
		) : (
			<nav class='nav' aria-label='Site'>
				<ul>
					{nav.map(({ href, label, n, on }) => (
						<li>
							<a href={href} aria-current={on ? 'page' : undefined}>
								<span>{label}</span>
								{n !== undefined && <span class='nav-n'>{n}</span>}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
	<slot />
	<Footer variant='side' />
</aside>

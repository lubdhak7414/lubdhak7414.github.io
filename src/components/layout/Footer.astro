---
import { siteConfig } from '@/site-config'

interface Props {
	/** `side`: the note at the foot of the sidebar. `page`: the same note under the content. */
	variant?: 'side' | 'page'
	class?: string
}

const { variant = 'page', class: className } = Astro.props
const year = new Date().getFullYear()
---

{/* data-nosnippet is only honoured on div/span/section, so it sits on a div */}
<footer class:list={['note', `note--${variant}`, className]}>
	<div data-nosnippet>
		<p>{`© ${year} ${siteConfig.author}`}</p>
	</div>
</footer>

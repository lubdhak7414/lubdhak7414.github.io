---
import { siteConfig } from '@/site-config'

// Key/value lines. The two profiles share one row as plain names, so no handle repeats.
const external = { target: '_blank', rel: 'noopener noreferrer' }
// The feed is XML, not a page: open it with a normal load and don't prefetch it on hover.
const feed = { 'data-astro-reload': true, 'data-astro-prefetch': 'false' }
const rows = [
	{
		key: 'email',
		links: [{ text: siteConfig.socials.email, href: `mailto:${siteConfig.socials.email}` }]
	},
	{
		key: 'profiles',
		links: [
			{ text: 'GitHub', href: siteConfig.socials.github, ...external },
			{ text: 'LinkedIn', href: siteConfig.socials.linkedin, ...external }
		]
	},
	{ key: 'rss', links: [{ text: '/rss.xml', href: '/rss.xml', ...feed }] }
]
---

<dl class='keys'>
	{
		rows.map(({ key, links }) => (
			<div>
				<dt>{key}</dt>
				<dd>
					{links.map(({ text, ...link }, i) => (
						<>
							{i > 0 && <span class='keys-sep' aria-hidden='true' set:text=' · ' />}
							<a {...link} set:text={text} />
						</>
					))}
				</dd>
			</div>
		))
	}
</dl>

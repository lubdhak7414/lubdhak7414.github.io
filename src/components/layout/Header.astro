---
import { siteConfig } from '@/site-config'

// Running head. Project pages count as Work; posts and tag archives count as Writing.
const path = Astro.url.pathname
const navItems = [
	{ href: '/#work', label: 'Work', active: path === '/' || path.startsWith('/projects/') },
	{
		href: '/blog/',
		label: 'Writing',
		active: path.startsWith('/blog') || path.startsWith('/tags')
	},
	{ href: '/about/', label: 'About', active: path.startsWith('/about') }
]

// Below 480px the name collapses to initials ("SUL").
const initials = siteConfig.author
	.split(/\s+/)
	.map((word) => word[0])
	.join('')
	.toUpperCase()
---

<header class='site-header'>
	<div class='container'>
		<a class='logo' href='/'
			><span class='full'>{siteConfig.author}</span><span class='short'>{initials}</span></a
		>
		<nav class='nav' aria-label='Main'>
			{
				navItems.map(({ href, label, active }) => (
					<a href={href} aria-current={active ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>
	</div>
</header>

---
import { Image } from 'astro:assets'
import avatar from '@/assets/face.png'
import { siteConfig } from '@/site-config'

interface Props {
	/** `home`: index links are in-page anchors with a scrollspy. `about`: About is current. */
	page: 'home' | 'about'
	counts: { work: number; writing: number }
}

const { page, counts } = Astro.props
const onHome = page === 'home'

// Initials sit under the photo as the avatar's fallback.
const initials = siteConfig.author
	.split(/\s+/)
	.map((word) => word[0])
	.join('')
	.toUpperCase()

// The rail doubles as the site's index: every section with what's in it.
const index = [
	{ href: onHome ? '#work' : '/#work', label: 'Work', n: counts.work, spy: 'work' },
	{ href: onHome ? '#writing' : '/blog/', label: 'Writing', n: counts.writing, spy: 'writing' },
	{ href: onHome ? '#background' : '/#background', label: 'Background', spy: 'background' },
	{ href: '/about/', label: 'About', current: page === 'about' }
]
---

<aside class='rail' aria-label='About the author'>
	<h1 class='rail-name'>
		{
			siteConfig.author.split(/\s+/).map((word, i) => (
				<>
					{i > 0 && ' '}
					<span>{word}</span>
				</>
			))
		}
	</h1>
	<p class='rail-dateline'><span>{siteConfig.role}</span><span>{siteConfig.location}</span></p>
	<div class='rail-intro'>
		<div class='avatar' aria-hidden='true'>
			{initials}<Image src={avatar} alt='' width={160} height={160} loading='eager' />
		</div>
		<p class='rail-bio'>{siteConfig.bio}</p>
	</div>
	<p class='rail-contact links'>
		<a class='link' href={`mailto:${siteConfig.socials.email}`}>Email</a>
		<a class='link' href={siteConfig.socials.github} target='_blank' rel='noopener noreferrer'
			>GitHub</a
		>
		<a class='link' href={siteConfig.socials.linkedin} target='_blank' rel='noopener noreferrer'
			>LinkedIn</a
		>
	</p>
	<nav class='rail-index' aria-label='Site'>
		{
			index.map(({ href, label, n, spy, current }) => (
				<a
					href={href}
					data-spy={onHome ? spy : undefined}
					aria-current={current ? 'page' : undefined}
				>
					<span>{label}</span>
					{n !== undefined && <span class='n'>{n}</span>}
				</a>
			))
		}
	</nav>
</aside>

<script>
	// Front page only: mark the index entry for the section being read, using the same
	// rule as the article TOC (the last section whose top has passed 35% of the viewport).
	;(() => {
		const links = document.querySelectorAll<HTMLAnchorElement>('.rail-index a[data-spy]')
		if (!links.length) return
		const sections = Array.from(links, (a) => document.getElementById(a.dataset.spy ?? ''))
		let ticking = false

		function update() {
			ticking = false
			const line = window.innerHeight * 0.35
			let current = -1
			sections.forEach((s, i) => {
				if (s && s.getBoundingClientRect().top <= line) current = i
			})
			if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
				current = sections.length - 1
			}
			links.forEach((a, i) => a.classList.toggle('active', i === current))
		}

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true
					requestAnimationFrame(update)
				}
			},
			{ passive: true }
		)
		window.addEventListener('resize', update)
		update()
	})()
</script>

---
export interface SpecLink {
	label: string
	url: string
	kind: 'code' | 'live' | 'store'
}
export interface SpecRow {
	key: string
	text?: string | undefined
	/** Printed as a wrapping list (the stack): no separator strands at a line end. */
	items?: string[] | undefined
	links?: SpecLink[]
}

interface Props {
	/** Key/value rows in print order; rows without a value drop out. */
	rows: SpecRow[]
}

const { rows } = Astro.props
const shown = rows.filter(
	({ text, items, links }) => text || (items && items.length > 0) || (links && links.length > 0)
)
---

{
	/* A project's spec sheet: one ruled table of what the page states (what it does, the client,
the owner's part, stack, status, links). Keys the page doesn't state are dropped, never filled.
The write-up's Key Takeaways follow in the tinted gist box. */
}
{
	shown.length > 0 && (
		<section class='spec' aria-labelledby='spec-h'>
			<h2 id='spec-h' class='spec-label'>
				At a glance
			</h2>
			<dl class='spec-table'>
				{shown.map(({ key, text, items, links }) => (
					<div class:list={['spec-row', `spec-row--${key.toLowerCase()}`]}>
						<dt set:text={key} />
						<dd>
							{text}
							{items && items.length > 0 && (
								<ul class='spec-items'>
									{items.map((item) => (
										<li set:text={item} />
									))}
								</ul>
							)}
							{links && (
								<ul class='spec-links'>
									{links.map(({ label, url }) => (
										<li>
											<a href={url} target='_blank' rel='noopener noreferrer'>
												<span class='spec-name' set:text={`${label} ↗`} />
											</a>
										</li>
									))}
								</ul>
							)}
						</dd>
					</div>
				))}
			</dl>
		</section>
	)
}

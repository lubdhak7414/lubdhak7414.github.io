---
import type { BriefSkill } from '@/utils/remarkBrief'

interface Props {
	skills: BriefSkill[]
}

const { skills } = Astro.props
---

{
	/* The write-up's own "Skills & Deliverables" list, lifted out of the body and set as a
two-column table (what, then what it means here) under the screenshot. */
}
{
	skills.length > 0 && (
		<section class='skills-tab' aria-labelledby='skills-h'>
			<h2 id='skills-h' class='label'>
				Skills
			</h2>
			<dl class='skill-table'>
				{skills.map(({ term, html }) => (
					<div>
						{term && <dt set:text={term} />}
						<dd set:html={html} />
					</div>
				))}
			</dl>
		</section>
	)
}

---
import type { SiteMeta } from '@/types'

import Footer from '@/components/layout/Footer.astro'
import MobileNav from '@/components/layout/MobileNav.astro'
import Sidebar from '@/components/layout/Sidebar.astro'
import type { Section } from '@/components/layout/Sidebar.astro'

import PageLayout from './BaseLayout.astro'
import { siteConfig } from '@/site-config'

interface Props {
	meta: SiteMeta
	page: Section
	/** Case studies and articles: the sidebar opens with a path line, not the identity block. */
	reading?: boolean
}

const { meta, page, reading = false } = Astro.props
---

{
	/* Every page: the sidebar (sticky on wide screens) and the page beside it. Slots: `side`
goes under the navigation (or the path line); `head` takes JSON-LD. */
}
<PageLayout meta={meta}>
	<slot name='head' />
	<MobileNav page={page} />
	<div class='frame'>
		<Sidebar page={page} reading={reading}>
			<slot name='side' />
		</Sidebar>
		<div class='main'>
			<slot />
			{
				/* Every page but Contact ends with the email as text and a link to Contact, so a visitor
				who lands on a case study or article from an email signature has a next step. */
			}
			{
				page !== 'contact' && (
					<p class='foot-contact'>
						<span>Email</span>
						<a href={`mailto:${siteConfig.socials.email}`} set:text={siteConfig.socials.email} />
						<span aria-hidden='true'>·</span>
						<a href='/contact/'>Contact</a>
					</p>
				)
			}
			{/* Below 960px the sidebar's footer note moves to the end of the page. */}
			<Footer class='main-foot' />
		</div>
	</div>
	<slot name='after' />
</PageLayout>

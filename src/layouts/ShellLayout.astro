---
import type { SiteMeta } from '@/types'

import Footer from '@/components/layout/Footer.astro'
import Sidebar from '@/components/layout/Sidebar.astro'
import type { Section } from '@/components/layout/Sidebar.astro'

import PageLayout from './BaseLayout.astro'

interface Props {
	meta: SiteMeta
	page: Section
	/** `project` gives the sidebar a compact identity line and a one-line nav (case studies). */
	sidebar?: 'site' | 'project'
}

const { meta, page, sidebar = 'site' } = Astro.props
---

{
	/* Every page: the sidebar (sticky on wide screens) and the page beside it. Slots: `intro`
goes under the name, before the navigation; `side` under the navigation; `head` takes JSON-LD. */
}
<PageLayout meta={meta}>
	<slot name='head' />
	<div class='frame'>
		<Sidebar page={page} variant={sidebar}>
			<slot name='intro' slot='intro' />
			<slot name='side' />
		</Sidebar>
		<div class='main'>
			<slot />
			{/* Below 960px the sidebar's footer note moves to the end of the page. */}
			<Footer class='main-foot' />
		</div>
	</div>
	<slot name='after' />
</PageLayout>

---
import type { CollectionEntry } from 'astro:content'

import CoverFigure from '@/components/CoverFigure.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import {
	PERSON_ID,
	displayTags,
	getEntrySocialImage,
	jsonLdScript,
	slugifyTag
} from '@/utils'
import { siteConfig } from '@/site-config'

import PageLayout from './BaseLayout.astro'

interface Props {
	project: CollectionEntry<'project'>
	prev?: CollectionEntry<'project'> | undefined
	next?: CollectionEntry<'project'> | undefined
}

const { project, prev, next } = Astro.props
const { data } = project
const { coverImage, description, facts, links, publishDate, title, updatedDate } = data

const social = await getEntrySocialImage(data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null

// Facts rail: one row per key the project actually has, in the reference's order.
const linksOf = (kind: 'code' | 'live' | 'store') => links.filter((l) => l.kind === kind)
const codeLinks = linksOf('code')
const liveLinks = linksOf('live')
const storeLinks = linksOf('store')
const tags = displayTags(project)
const bareUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '')

const projectUrl = new URL(`/projects/${project.id}/`, Astro.site).toString()
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: (updated ?? publishDate).toISOString(),
	...(social.src && { image: new URL(social.src, Astro.site).toString() }),
	author: authorRef,
	publisher: authorRef,
	mainEntityOfPage: { '@type': 'WebPage', '@id': projectUrl }
}
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: title, item: projectUrl }
	]
}
---

<PageLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: updated?.toISOString(),
		title
	}}
>
	<script type='application/ld+json' set:html={jsonLdScript(articleSchema)} is:inline />
	<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	<div class='container page'>
		<a class='back' href='/#work'>← All work</a>
		<header class='p-header'>
			<p class='meta'>
				{data.draft && '(Draft) / '}<FormattedDate date={publishDate} />
				{
					updated && (
						<>
							{' / Updated '}
							<FormattedDate date={updated} />
						</>
					)
				}
			</p>
			<h1 class='display'>{title}</h1>
			<p class='lede'>{description}</p>
			{
				links.length > 0 && (
					<div class='links'>
						{links.map((link) => (
							<a class='link' href={link.url} target='_blank' rel='noopener noreferrer'>
								{link.label} →
							</a>
						))}
					</div>
				)
			}
		</header>
		{
			coverImage && (
				<div class='p-hero'>
					<CoverFigure
						src={coverImage.src}
						alt={coverImage.alt}
						sizes='(min-width: 1152px) 1024px, 100vw'
					/>
				</div>
			)
		}
		<div class='detail'>
			<dl class='facts' aria-label='Project facts'>
				{
					facts.client && (
						<div class='fact'>
							<dt>Client</dt>
							<dd>{facts.client}</dd>
						</div>
					)
				}
				{
					facts.role && (
						<div class='fact'>
							<dt>Role</dt>
							<dd>{facts.role}</dd>
						</div>
					)
				}
				{
					facts.timeline && (
						<div class='fact'>
							<dt>Timeline</dt>
							<dd>
								<span class='mono'>{facts.timeline}</span>
							</dd>
						</div>
					)
				}
				{
					facts.status && (
						<div class='fact'>
							<dt>Status</dt>
							<dd>
								<span class='status'>{facts.status}</span>
							</dd>
						</div>
					)
				}
				{
					facts.license && (
						<div class='fact'>
							<dt>License</dt>
							<dd>{facts.license}</dd>
						</div>
					)
				}
				{
					[
						{ label: codeLinks.length > 1 ? 'Repositories' : 'Repository', items: codeLinks },
						{ label: 'Live site', items: liveLinks },
						{ label: 'Store page', items: storeLinks }
					]
						.filter(({ items }) => items.length > 0)
						.map(({ label, items }) => (
							<div class='fact'>
								<dt>{label}</dt>
								<dd class='link-list'>
									{items.map((link) => (
										<a class='link mono' href={link.url} target='_blank' rel='noopener noreferrer'>
											{bareUrl(link.url)}
										</a>
									))}
								</dd>
							</div>
						))
				}
				{
					facts.stack && facts.stack.length > 0 && (
						<div class='fact'>
							<dt>Stack</dt>
							<dd>
								<span class='stack-list'>{facts.stack.join(' / ')}</span>
							</dd>
						</div>
					)
				}
				{
					tags.length > 0 && (
						<div class='fact'>
							<dt>Tags</dt>
							<dd class='stack-list'>
								{tags.map((tag, i) => (
									<>
										{i > 0 && ' / '}
										<a class='link' href={`/tags/${slugifyTag(tag)}/`}>
											{tag}
										</a>
									</>
								))}
							</dd>
						</div>
					)
				}
			</dl>
			<article class='narrative'>
				<div class='prose'>
					<slot />
				</div>
				{
					prev && next && (
						<nav class='pager' aria-label='More projects'>
							<a href={`/projects/${prev.id}/`}>
								<span class='meta'>Previous</span>
								<span>← {prev.data.title}</span>
							</a>
							<a href={`/projects/${next.id}/`}>
								<span class='meta'>Next</span>
								<span>{next.data.title} →</span>
							</a>
						</nav>
					)
				}
			</article>
		</div>
	</div>
</PageLayout>

---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import CoverFigure from '@/components/CoverFigure.astro'
import TOC from '@/components/blog/TOC.astro'
import Details from '@/components/doc/Details.astro'
import type { DetailRow } from '@/components/doc/Details.astro'
import WorkRow from '@/components/project/WorkRow.astro'
import {
	PERSON_ID,
	displayTags,
	getEntrySocialImage,
	isoDate,
	jsonLdScript,
	slugifyTag
} from '@/utils'
import { siteConfig } from '@/site-config'

import ShellLayout from './ShellLayout.astro'

interface Props {
	project: CollectionEntry<'project'>
	next?: CollectionEntry<'project'> | undefined
}

const { project, next } = Astro.props
const { data } = project
const { headings, remarkPluginFrontmatter } = await render(project)
const { coverImage, description, facts, links, publishDate, title, updatedDate } = data

const social = await getEntrySocialImage(data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null

// The details list: one row per fact the project actually has (rows without a value drop out).
const tags = displayTags(project)
const linkRows = (['code', 'live', 'store'] as const).map((kind) => ({
	key: kind,
	links: links
		.filter((link) => link.kind === kind)
		.map((link) => ({ label: link.label, href: link.url, external: true }))
}))
const details: DetailRow[] = [
	{ key: 'year', text: String(publishDate.getFullYear()) },
	{ key: 'updated', text: updated ? isoDate(updated) : undefined },
	{ key: 'client', text: facts.client },
	{ key: 'role', text: facts.role },
	{ key: 'timeline', text: facts.timeline },
	{ key: 'status', text: facts.status },
	{ key: 'license', text: facts.license },
	{ key: 'stack', text: facts.stack?.join(', ') },
	...linkRows,
	{ key: 'reading', text: remarkPluginFrontmatter.minutesRead },
	{ key: 'topics', links: tags.map((tag) => ({ label: tag, href: `/tags/${slugifyTag(tag)}/` })) }
]

const projectUrl = new URL(`/projects/${project.id}/`, Astro.site).toString()
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: (updated ?? publishDate).toISOString(),
	...(social.src && { image: new URL(social.src, Astro.site).toString() }),
	author: authorRef,
	publisher: authorRef,
	mainEntityOfPage: { '@type': 'WebPage', '@id': projectUrl }
}
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: title, item: projectUrl }
	]
}
---

<ShellLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: updated?.toISOString(),
		title
	}}
	page='work'
>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(articleSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	</Fragment>
	<Fragment slot='side'>
		<div class='side-doc'>
			<p class='label'>Details</p>
			<Details rows={details} />
		</div>
		<TOC headings={headings} variant='sidebar' />
	</Fragment>

	<article class='doc'>
		<header class='doc-head'>
			<p class='label'>
				{data.draft && 'Draft · '}<a href='/#work'>Case study</a>
			</p>
			<h1 class='doc-title'>{title}</h1>
			<p class='doc-lede'>{description}</p>
			<Details rows={details} class='doc-details' />
		</header>
		{
			coverImage && (
				<div class='doc-cover'>
					<CoverFigure
						src={coverImage.src}
						alt={coverImage.alt}
						sizes='(min-width: 960px) 704px, 100vw'
					/>
				</div>
			)
		}
		<TOC headings={headings} variant='drawer' />
		<div class='prose'>
			<slot />
		</div>
	</article>
	{
		next && next.id !== project.id && (
			<nav class='next' aria-labelledby='next-h'>
				<h2 id='next-h' class='label'>
					Next case study
				</h2>
				<ul class='rows'>
					<WorkRow project={next} />
				</ul>
			</nav>
		)
	}
</ShellLayout>

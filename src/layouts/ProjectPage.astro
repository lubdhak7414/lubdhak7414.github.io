---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import CoverFigure from '@/components/CoverFigure.astro'
import TOC from '@/components/blog/TOC.astro'
import Details from '@/components/doc/Details.astro'
import type { DetailRow } from '@/components/doc/Details.astro'
import ProjectDirectory from '@/components/project/ProjectDirectory.astro'
import Shot from '@/components/project/Shot.astro'
import { PERSON_ID, getEntrySocialImage, jsonLdScript } from '@/utils'
import { siteConfig } from '@/site-config'

import ShellLayout from './ShellLayout.astro'

interface Props {
	project: CollectionEntry<'project'>
	prev?: CollectionEntry<'project'> | undefined
	next?: CollectionEntry<'project'> | undefined
}

const { project, prev, next } = Astro.props
const { data } = project
const { headings } = await render(project)
const { description, facts, links, publishDate, shot, title, updatedDate } = data

const social = await getEntrySocialImage(data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null

// The meta line under the title (who it was for) and the details beside the screenshot: only
// facts the project actually has (rows without a value drop out). Links live in the details.
const meta = [facts.role, facts.client && `Client: ${facts.client}`].filter(Boolean).join(' · ')
const linkRows = (['code', 'live', 'store'] as const).map((kind) => ({
	key: kind,
	links: links
		.filter((link) => link.kind === kind)
		.map((link) => ({ label: link.label, href: link.url, external: true }))
}))
const details: DetailRow[] = [
	{ key: 'stack', text: facts.stack?.join(', ') },
	{ key: 'status', text: facts.status },
	{ key: 'timeline', text: facts.timeline },
	{ key: 'license', text: facts.license },
	...linkRows
]

const projectUrl = new URL(`/projects/${project.id}/`, Astro.site).toString()
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: (updated ?? publishDate).toISOString(),
	...(social.src && { image: new URL(social.src, Astro.site).toString() }),
	author: authorRef,
	publisher: authorRef,
	mainEntityOfPage: { '@type': 'WebPage', '@id': projectUrl }
}
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: title, item: projectUrl }
	]
}
---

<ShellLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: updated?.toISOString(),
		title
	}}
	page='work'
	sidebar='project'
>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(articleSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	</Fragment>
	<Fragment slot='side'>
		<ProjectDirectory current={project.id} variant='side' />
		<TOC headings={headings} variant='sidebar' />
	</Fragment>

	<article class='doc'>
		<header class='doc-head'>
			<p class='label'>
				{data.draft && 'Draft · '}<a href='/#work'>Case study</a>
			</p>
			<h1 class='doc-title'>{title}</h1>
			<p class='doc-lede'>{description}</p>
			{
				meta && (
					<p class='doc-meta'>
						<span set:text={meta} />
					</p>
				)
			}
		</header>
		<div class:list={['twoup', !shot && 'twoup--solo']}>
			{
				shot && (
					<CoverFigure
						src={shot.src}
						alt={shot.alt}
						sizes='(min-width: 960px) 420px, (min-width: 700px) 60vw, 100vw'
					/>
				)
			}
			<div class='twoup-details'>
				<p class='label'>Details</p>
				<Details rows={details} />
			</div>
		</div>
		<TOC headings={headings} variant='drawer' />
		<div class='prose'>
			<slot />
		</div>
	</article>
	{
		prev && next && next.id !== project.id && (
			<nav class='pn' aria-label='More case studies'>
				{[
					{ to: prev, dir: 'prev', label: '← Previous' },
					{ to: next, dir: 'next', label: 'Next →' }
				].map(({ to, dir, label }) => (
					<div class:list={['pn-item', `pn-item--${dir}`]}>
						<Shot project={to} widths={[240, 360]} sizes='112px' class='pn-shot' />
						<div class='pn-body'>
							<p class='label' set:text={label} />
							<a
								class='pn-link'
								href={`/projects/${to.id}/`}
								set:text={to.data.name ?? to.data.title}
							/>
							<p class='pn-text'>{to.data.description}</p>
						</div>
					</div>
				))}
			</nav>
		)
	}
	<ProjectDirectory current={project.id} variant='page' />
</ShellLayout>

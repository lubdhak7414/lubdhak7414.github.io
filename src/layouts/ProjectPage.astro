---
import type { ImageMetadata } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import TOC from '@/components/blog/TOC.astro'
import Gist from '@/components/doc/Gist.astro'
import Skills from '@/components/doc/Skills.astro'
import UpNext from '@/components/doc/UpNext.astro'
import type { DetailRow } from '@/components/doc/Details.astro'
import Gallery from '@/components/project/Gallery.astro'
import type { Slide } from '@/components/project/Gallery.astro'
import ProjectDirectory from '@/components/project/ProjectDirectory.astro'
import {
	PERSON_ID,
	displayTags,
	generateToc,
	getAllProjects,
	getEntrySocialImage,
	groupProjects,
	jsonLdScript
} from '@/utils'
import type { BriefFigure, BriefSkill } from '@/utils/remarkBrief'
import { siteConfig } from '@/site-config'

import ShellLayout from './ShellLayout.astro'

interface Props {
	project: CollectionEntry<'project'>
	prev?: CollectionEntry<'project'> | undefined
	next?: CollectionEntry<'project'> | undefined
}

const { project, prev, next } = Astro.props
const { data } = project
const { headings, remarkPluginFrontmatter: brief } = await render(project)
const { description, facts, links, publishDate, shot, title, updatedDate } = data
const takeaways = (brief.takeaways ?? []) as string[]
const skills = (brief.skills ?? []) as BriefSkill[]
const figures = (brief.figures ?? []) as BriefFigure[]

const social = await getEntrySocialImage(data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null

// Where this case study sits: its group ("Software", "Websites") and its place in the
// homepage order, which the previous/next links follow.
const all = await getAllProjects()
const place = (id: string) => `${all.findIndex((p) => p.id === id) + 1} / ${all.length}`
const group = groupProjects(all).find(({ items }) => items.some((p) => p.id === project.id))?.label
const around = prev && next && next.id !== project.id ? { prev, next } : null
const short = (p: CollectionEntry<'project'>) => p.data.name ?? p.data.title

// The first screen: a button per link, then the gist (the write-up's own Key Takeaways, then
// only the facts it actually has).
const kindLabel = { code: 'code', live: 'live', store: 'store' } as const
const details: DetailRow[] = [
	{ key: 'client', text: facts.client },
	{ key: 'role', text: facts.role },
	{ key: 'timeline', text: facts.timeline },
	{ key: 'status', text: facts.status },
	{ key: 'stack', text: facts.stack?.join(' · ') },
	{ key: 'license', text: facts.license }
]

// The gallery: the frontmatter screenshot, then every other image the write-up shows, each
// linked to the section it sits in. Body images resolve from the project's own folder.
const folder = import.meta.glob<{ default: ImageMetadata }>(
	'/src/content/project/*/*.{png,jpg,jpeg,webp}',
	{ eager: true }
)
const sections = generateToc(headings)
const sectionFor = (text: string | null | undefined): Slide['section'] => {
	const i = text ? sections.findIndex((h) => h.text === text) : -1
	const h = sections[i]
	return h ? { slug: h.slug, n: i + 1, text: h.text } : undefined
}
const fromBody = figures.map((f) => ({
	...f,
	src: folder[`/src/content/project/${project.id}/${f.url.replace(/^\.\//, '')}`]?.default
}))
const slides: Slide[] = []
const seen = new Set<string>()
const add = (src: ImageMetadata | undefined, alt: string, section: Slide['section']) => {
	if (!src || seen.has(src.src)) return
	seen.add(src.src)
	slides.push({ src, alt, section })
}
if (shot) {
	const inBody = fromBody.find((f) => f.src?.src === shot.src.src)
	add(shot.src, shot.alt, sectionFor(inBody?.section))
}
for (const f of fromBody) add(f.src, f.alt, sectionFor(f.section))

// Topics stay out of sight: only the head (article:tag) and the JSON-LD (keywords) carry them.
const tags = displayTags(project)
const projectUrl = new URL(`/projects/${project.id}/`, Astro.site).toString()
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: (updated ?? publishDate).toISOString(),
	...(social.src && { image: new URL(social.src, Astro.site).toString() }),
	author: authorRef,
	publisher: authorRef,
	...(tags.length > 0 && { keywords: tags }),
	mainEntityOfPage: { '@type': 'WebPage', '@id': projectUrl }
}
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: title, item: projectUrl }
	]
}
const diveNote = `The write-up · ${sections.length} ${sections.length === 1 ? 'section' : 'sections'} · ${brief.minutesRead}`
---

<ShellLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: updated?.toISOString(),
		tags,
		title
	}}
	page='work'
	reading
>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(articleSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	</Fragment>
	<Fragment slot='side'>
		<TOC headings={headings} variant='sidebar' />
		<ProjectDirectory current={project.id} variant='side' />
	</Fragment>

	<article class='doc doc--case'>
		<header class='doc-head'>
			<div class='doc-kicker'>
				<p class='label'>
					{data.draft && 'Draft · '}<a href='/projects/'>Case study</a>{group && ` · ${group}`}
				</p>
			</div>
			<h1 class='doc-title'>{title}</h1>
			<p class='doc-lede'>{description}</p>
			{
				links.length > 0 && (
					<ul class='doc-actions' aria-label='Links'>
						{links.map((link) => (
							<li>
								<a class='btn' href={link.url} target='_blank' rel='noopener noreferrer'>
									<span class='btn-kind' set:text={kindLabel[link.kind]} />
									<span set:text={`${link.label} ↗`} />
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>
		<Gist takeaways={takeaways} rows={details} />
		<Gallery slides={slides} />
		<Skills skills={skills} />
		<p class='dive label' set:text={diveNote} />
		<TOC headings={headings} variant='drawer' />
		<div class='prose'>
			<slot />
		</div>
	</article>
	{
		around && (
			<UpNext
				label='Next case study'
				count={place(around.next.id)}
				href={`/projects/${around.next.id}/`}
				title={short(around.next)}
				text={around.next.data.description}
				meta={(around.next.data.facts.stack ?? []).slice(0, 4).join(' · ')}
				go='Read the case study'
				image={around.next.data.shot}
				back={{ href: `/projects/${around.prev.id}/`, label: `← ${short(around.prev)}` }}
			/>
		)
	}
	<ProjectDirectory current={project.id} variant='page' />
</ShellLayout>

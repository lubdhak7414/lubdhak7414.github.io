---
import type { SiteMeta } from '@/types'

import { ClientRouter } from 'astro:transitions'

import BaseHead from '@/components/BaseHead.astro'

import { siteConfig } from '@/site-config'

interface Props {
	meta: SiteMeta
}

const {
	meta: {
		description = siteConfig.description,
		ogImage,
		ogImageWidth,
		ogImageHeight,
		publishDate,
		modifiedDate,
		noIndex,
		tags,
		title
	}
} = Astro.props

// No header and no global footer: ShellLayout's sidebar carries the navigation and the
// site notice on every page.
---

<html lang={siteConfig.lang}>
	<head>
		<BaseHead
			description={description}
			ogImage={ogImage}
			ogImageWidth={ogImageWidth}
			ogImageHeight={ogImageHeight}
			publishDate={publishDate}
			modifiedDate={modifiedDate}
			noIndex={noIndex}
			tags={tags}
			title={title}
		/>
		{/* Pages swap in place (no full reload); scripts re-run on astro:page-load. */}
		<ClientRouter />
	</head>

	<body>
		<a class='skip-link' href='#content'>Skip to content</a>
		<main id='content'>
			<slot />
		</main>
		<script>
			// After a link swaps the page in, move keyboard focus to the new page's heading, as a full
			// load would (the next Tab lands in the new page; screen readers hear where they are).
			// Back/Forward and links to a #section keep the browser's own position.
			let moved = false
			document.addEventListener('astro:before-preparation', (e) => {
				moved = e.navigationType === 'push' || e.navigationType === 'replace'
			})
			document.addEventListener('astro:page-load', () => {
				if (!moved || location.hash) return
				moved = false
				const target =
					document.querySelector<HTMLElement>('main h1') ?? document.querySelector('main')
				if (!target) return
				if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1')
				target.focus({ preventScroll: true })
			})
		</script>
	</body>
</html>

---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import TOC from '@/components/blog/TOC.astro'
import AuthorBox from '@/components/AuthorBox.astro'
import CoverFigure from '@/components/CoverFigure.astro'
import BalloonSurprise from '@/components/blog/BalloonSurprise.astro'
import WritingDirectory from '@/components/blog/WritingDirectory.astro'
import Gist from '@/components/doc/Gist.astro'
import UpNext from '@/components/doc/UpNext.astro'

import {
	PERSON_ID,
	displayTags,
	generateToc,
	getEntrySocialImage,
	isoDate,
	jsonLdScript,
	slugifyTag
} from '@/utils'
import { siteConfig } from '@/site-config'

import ShellLayout from './ShellLayout.astro'

interface Props {
	post: CollectionEntry<'post'>
	next?: CollectionEntry<'post'> | undefined
}

const { post, next } = Astro.props
const {
	data: { coverImage, description, draft, publishDate, title, updatedDate }
} = post

// `ogImage` (frontmatter) is an unprocessed string with unknown dimensions, so
// width/height are only emitted for the coverImage fallback.
const social = await getEntrySocialImage(post.data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null
const modifiedIso = updated?.toISOString()
const { headings, remarkPluginFrontmatter } = await render(post)
const minutesRead = parseInt(remarkPluginFrontmatter.minutesRead, 10) || 1
const tags = displayTags(post)
const takeaways = (remarkPluginFrontmatter.takeaways ?? []) as string[]
const sections = generateToc(headings)
// One meta line under the title: when, how long, then the topics as links.
const when = [
	isoDate(publishDate),
	updated && `updated ${isoDate(updated)}`,
	remarkPluginFrontmatter.minutesRead
]
	.filter(Boolean)
	.join(' · ')
const diveNote = `The article · ${sections.length} ${sections.length === 1 ? 'section' : 'sections'} · ${remarkPluginFrontmatter.minutesRead}`

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).toString()
const blogUrl = new URL('/blog/', Astro.site).toString()
const ogAbsolute = social.src ? new URL(social.src, Astro.site).toString() : undefined
// Reference the canonical Person entity (defined in full on the homepage + /about)
// by `@id` so Google consolidates the entity, but still inline `name`: the Person
// node isn't on this page, and Google requires `name` once an author object exists.
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
		{ '@type': 'ListItem', position: 3, name: title, item: postUrl }
	]
}
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: modifiedIso ?? publishIso,
	...(ogAbsolute && { image: ogAbsolute }),
	author: authorRef,
	publisher: authorRef,
	timeRequired: `PT${minutesRead}M`,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl
	}
}
---

<ShellLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: modifiedIso,
		title
	}}
	page='writing'
	sidebar='project'
>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(blogPostingSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	</Fragment>
	<Fragment slot='side'>
		<WritingDirectory current={post.id} />
		<TOC headings={headings} variant='sidebar' />
	</Fragment>

	<div class='progress' aria-hidden='true'></div>
	<article class='doc doc--post'>
		<header class='doc-head'>
			<div class='doc-kicker'>
				<p class='label'>{draft && 'Draft · '}<a href='/blog/'>Writing</a></p>
			</div>
			<h1 class='doc-title'>{title}</h1>
			<p class='doc-lede'>{description}</p>
			<p class='doc-meta'>
				<time datetime={isoDate(publishDate)} set:text={when} />
				{
					tags.length > 0 && (
						<span class='doc-topics'>
							{tags.map((tag) => (
								<a href={`/tags/${slugifyTag(tag)}/`} set:text={tag} />
							))}
						</span>
					)
				}
			</p>
		</header>
		<Gist takeaways={takeaways} />
		{
			coverImage && (
				<div class='doc-cover'>
					<CoverFigure
						src={coverImage.src}
						alt={coverImage.alt}
						sizes='(min-width: 960px) 704px, 100vw'
					/>
				</div>
			)
		}
		<p class='dive label' set:text={diveNote} />
		<TOC headings={headings} variant='drawer' />
		<div class='prose'>
			<slot />
		</div>
		<AuthorBox />
	</article>
	{
		next && next.id !== post.id && (
			<UpNext
				label='Read next'
				href={`/blog/${next.id}/`}
				title={next.data.title}
				text={next.data.description}
				meta={`${isoDate(next.data.publishDate)} · ${displayTags(next).join(' · ')}`}
				go='Read the article'
				image={next.data.coverImage}
				back={{ href: '/blog/', label: '← All writing' }}
			/>
		)
	}
	<BalloonSurprise slot='after' />
</ShellLayout>

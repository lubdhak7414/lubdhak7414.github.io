---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import TOC from '@/components/blog/TOC.astro'
import AuthorBox from '@/components/AuthorBox.astro'
import CoverFigure from '@/components/CoverFigure.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import RelatedPosts from '@/components/blog/RelatedPosts.astro'
import BalloonSurprise from '@/components/blog/BalloonSurprise.astro'

import { PERSON_ID, displayTags, getEntrySocialImage, jsonLdScript, slugifyTag } from '@/utils'
import { siteConfig } from '@/site-config'

import PageLayout from './BaseLayout.astro'

interface Props {
	post: CollectionEntry<'post'>
	relatedPosts?: CollectionEntry<'post'>[]
}

const { post, relatedPosts = [] } = Astro.props
const {
	data: { coverImage, description, draft, publishDate, title, updatedDate }
} = post

// `ogImage` (frontmatter) is an unprocessed string with unknown dimensions, so
// width/height are only emitted for the coverImage fallback.
const social = await getEntrySocialImage(post.data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null
const modifiedIso = updated?.toISOString()
const { headings, remarkPluginFrontmatter } = await render(post)
const minutesRead = parseInt(remarkPluginFrontmatter.minutesRead, 10) || 1
const tags = displayTags(post)

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).toString()
const blogUrl = new URL('/blog/', Astro.site).toString()
const ogAbsolute = social.src ? new URL(social.src, Astro.site).toString() : undefined
// Reference the canonical Person entity (defined in full on the homepage + /about)
// by `@id` so Google consolidates the entity, but still inline `name`: the Person
// node isn't on this page, and Google requires `name` once an author object exists.
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
		{ '@type': 'ListItem', position: 3, name: title, item: postUrl }
	]
}
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: modifiedIso ?? publishIso,
	...(ogAbsolute && { image: ogAbsolute }),
	author: authorRef,
	publisher: authorRef,
	timeRequired: `PT${minutesRead}M`,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl
	}
}
---

<PageLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: modifiedIso,
		title
	}}
>
	<script type='application/ld+json' set:html={jsonLdScript(blogPostingSchema)} is:inline />
	<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	<div class='page container'>
		<header class='doc-head'>
			<p class='kicker'>
				{draft && 'Draft · '}<a href='/blog/'>Writing</a>
				<span class='meta'>
					<FormattedDate date={publishDate} />
					{
						updated && (
							<>
								{' · Updated '}
								<FormattedDate date={updated} />
							</>
						)
					}
				</span>
			</p>
			<h1 class='display'>{title}</h1>
			<p class='lede'>{description}</p>
			<p class='byline'>
				By <a href='/about/'>{siteConfig.author}</a> · {remarkPluginFrontmatter.minutesRead}
			</p>
		</header>
		<div class='reader'>
			{
				coverImage && (
					<div class='doc-cover'>
						<CoverFigure
							src={coverImage.src}
							alt={coverImage.alt}
							sizes='(min-width: 768px) 720px, 100vw'
						/>
					</div>
				)
			}
			<TOC headings={headings} variant='sidebar' />
			{
				tags.length > 0 && (
					<aside class='facts facts--end' aria-label='Topics'>
						<p class='kicker'>Filed under</p>
						<ul class='topics'>
							{tags.map((tag) => (
								<li>
									<a href={`/tags/${slugifyTag(tag)}/`} set:text={tag} />
								</li>
							))}
						</ul>
					</aside>
				)
			}
			<article class='reader-body'>
				<TOC headings={headings} variant='drawer' />
				<div class='prose'>
					<slot />
				</div>
			</article>
			<div class='reader-end'>
				<AuthorBox />
				<RelatedPosts posts={relatedPosts} />
			</div>
		</div>
	</div>
	<BalloonSurprise />
</PageLayout>

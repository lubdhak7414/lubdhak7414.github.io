---
import type { ImageMetadata } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

import TOC from '@/components/blog/TOC.astro'
import AuthorBox from '@/components/AuthorBox.astro'
import CoverFigure from '@/components/CoverFigure.astro'
import BalloonSurprise from '@/components/blog/BalloonSurprise.astro'
import SeriesBlock from '@/components/blog/SeriesBlock.astro'
import WritingDirectory from '@/components/blog/WritingDirectory.astro'
import Gist from '@/components/doc/Gist.astro'
import SideNext from '@/components/doc/SideNext.astro'
import UpNext from '@/components/doc/UpNext.astro'

import type { Series } from '@/utils'
import { PERSON_ID, displayTags, getEntrySocialImage, isoDate, jsonLdScript } from '@/utils'
import { noteLabel, seriesPlace, tidyTitle } from '@/utils/series'
import { keepCode, typeset } from '@/utils/typeset'
import { siteConfig } from '@/site-config'

import ShellLayout from './ShellLayout.astro'

interface Props {
	post: CollectionEntry<'post'>
	next?: CollectionEntry<'post'> | undefined
	/** Series preview: the part before this one, and the series this post belongs to. */
	prev?: CollectionEntry<'post'> | undefined
	series?: Series | undefined
}

const { post, next, prev, series } = Astro.props
const {
	data: { coverImage, description, draft, publishDate, title, updatedDate }
} = post

// `ogImage` (frontmatter) is an unprocessed string with unknown dimensions, so
// width/height are only emitted for the coverImage fallback.
const social = await getEntrySocialImage(post.data)
const publishIso = publishDate.toISOString()
const updated = updatedDate && updatedDate.valueOf() !== publishDate.valueOf() ? updatedDate : null
const modifiedIso = updated?.toISOString()
const { headings, remarkPluginFrontmatter } = await render(post)
const minutesRead = parseInt(remarkPluginFrontmatter.minutesRead, 10) || 1
const takeaways = (remarkPluginFrontmatter.takeaways ?? []) as string[]
// Topics stay out of sight: only the head (article:tag) and the JSON-LD (keywords) carry them.
const tags = displayTags(post)
// One meta line under the title: when and how long.
const when = [
	isoDate(publishDate),
	updated && `updated ${isoDate(updated)}`,
	remarkPluginFrontmatter.minutesRead
]
	.filter(Boolean)
	.join(' · ')
// A note in a series: its half and number, for the kicker and the card at the end.
const place = series && seriesPlace(series, post.id)
const crossing = place && !place.next && place.nextHalf
// The card at the end names the note it points to, not the one being read.
const nextPlace = series && next ? seriesPlace(series, next.id) : undefined

// Series figures: each one links to its full-size file, and a figure that has a narrow
// "<name>-phone.svg" beside it shows that one on phones, where the wide drawing's labels would
// shrink to a few pixels.
const phoneUrls = import.meta.glob<string>('/src/content/post/*/img/*-phone.svg', {
	query: '?url',
	import: 'default',
	eager: true
})
const phoneSvgs = import.meta.glob<string>('/src/content/post/*/img/*-phone.svg', {
	query: '?raw',
	import: 'default',
	eager: true
})
const phoneByName = new Map(
	Object.entries(phoneUrls).map(([path, url]) => {
		const svg = phoneSvgs[path] ?? ''
		const box = /viewBox="0 0 ([\d.]+) ([\d.]+)"/.exec(svg)
		return [path.split('/').pop()!, { url, width: box?.[1], height: box?.[2] }]
	})
)
const unescape = (value: string) => value.replaceAll('&amp;', '&')
const escape = (value: string) => value.replaceAll('&', '&amp;').replaceAll('"', '&quot;')
function figure(img: string) {
	const src = /\ssrc="([^"]+)"/.exec(img)?.[1]
	if (!src) return img
	const name = /([\w.-]+)\.svg/.exec(decodeURIComponent(unescape(src)))?.[1]
	if (!name) return img
	// Built files carry a content hash ("name.HASH.svg"); the dev server does not.
	const phone =
		phoneByName.get(`${name}-phone.svg`) ??
		phoneByName.get(`${name.replace(/\.[\w-]+$/, '')}-phone.svg`)
	const picture = phone
		? `<picture><source media="(max-width: 639px)" srcset="${escape(phone.url)}"${phone.width ? ` width="${phone.width}" height="${phone.height}"` : ''}>${img}</picture>`
		: img
	return `<figure class="fig"><a class="fig-link" href="${src}" data-astro-reload data-astro-prefetch="false">${picture}</a><figcaption class="fig-hint" aria-hidden="true"><span class="fig-tap">Tap to enlarge</span><span class="fig-click">Click to enlarge</span></figcaption></figure>`
}
// Any other article: a body image "<name>.webp" with a "<name>-phone.webp" beside it (a drawing
// restacked for a narrow screen) shows the phone one below 640px.
const phoneWebps = import.meta.glob<string>('/src/content/post/*/*-phone.webp', {
	query: '?url',
	import: 'default',
	eager: true
})
const phoneHere = Object.entries(phoneWebps)
	.filter(([path]) => path.startsWith(`/src/content/post/${post.id}/`))
	.map(([path, url]) => ({
		name: path
			.split('/')
			.pop()!
			.replace(/-phone\.webp$/, ''),
		url
	}))
function phonePicture(img: string) {
	const src = decodeURIComponent(unescape(/\ssrc="([^"]+)"/.exec(img)?.[1] ?? ''))
	const phone = phoneHere.find(({ name }) => src.includes(`/${name}.`))
	return phone
		? `<picture><source media="(max-width: 639px)" srcset="${escape(phone.url)}">${img}</picture>`
		: img
}
// A cover with a "cover-phone.webp" beside it (the same drawing restacked) shows that on phones.
const coverPhones = import.meta.glob<ImageMetadata>('/src/content/post/*/cover-phone.webp', {
	import: 'default',
	eager: true
})
const coverPhone = coverPhones[`/src/content/post/${post.id}/cover-phone.webp`]
const body = await Astro.slots.render('default')
const content = keepCode(
	series
		? body.replace(/<img\b[^>]*>/g, figure)
		: phoneHere.length
			? body.replace(/<img\b[^>]*>/g, phonePicture)
			: body
)

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).toString()
const blogUrl = new URL('/blog/', Astro.site).toString()
const ogAbsolute = social.src ? new URL(social.src, Astro.site).toString() : undefined
// Reference the canonical Person entity (defined in full on the homepage + /about)
// by `@id` so Google consolidates the entity, but still inline `name`: the Person
// node isn't on this page, and Google requires `name` once an author object exists.
const authorRef = { '@id': PERSON_ID, name: siteConfig.author }
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
		{ '@type': 'ListItem', position: 3, name: title, item: postUrl }
	]
}
const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: publishIso,
	dateModified: modifiedIso ?? publishIso,
	...(ogAbsolute && { image: ogAbsolute }),
	author: authorRef,
	publisher: authorRef,
	timeRequired: `PT${minutesRead}M`,
	...(tags.length > 0 && { keywords: tags }),
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl
	}
}
---

<ShellLayout
	meta={{
		description,
		ogImage: social.src,
		ogImageWidth: social.width,
		ogImageHeight: social.height,
		publishDate: publishIso,
		modifiedDate: modifiedIso,
		tags,
		title
	}}
	page='writing'
	reading
>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(blogPostingSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(breadcrumbSchema)} is:inline />
	</Fragment>
	<Fragment slot='side'>
		<TOC headings={headings} variant='sidebar' />
		<WritingDirectory current={post.id} series={series} />
		{
			next && next.id !== post.id && (
				<SideNext
					label={
						series ? (crossing ? `On to the ${crossing.section.label}` : 'Next note') : 'Read next'
					}
					href={`/blog/${next.id}/`}
					title={next.data.title}
				/>
			)
		}
	</Fragment>

	<article class='doc doc--post'>
		<header class='doc-head'>
			<div class='doc-kicker'>
				<p class='label'>
					<a href='/blog/'>Writing</a>
					{
						series && (
							<>
								{' · '}
								<a href={`/series/${series.slug}/`} set:text={series.name} />
								{place?.section.label && ` · ${place.section.label}`}
							</>
						)
					}
					{draft && ' · Draft'}
				</p>
			</div>
			<h1 class='doc-title' set:text={typeset(tidyTitle(title))} />
			<p class='doc-lede' set:text={typeset(description)} />
			<p class='doc-meta'>
				<time datetime={isoDate(publishDate)} set:text={when} />
			</p>
		</header>
		{series && <SeriesBlock series={series} current={post.id} />}
		<Gist takeaways={takeaways} />
		{
			coverImage && (
				<div class='doc-cover'>
					<CoverFigure
						src={coverImage.src}
						alt={coverImage.alt}
						sizes='(min-width: 640px) 544px, 100vw'
						phone={coverPhone}
					/>
				</div>
			)
		}
		<TOC headings={headings} variant='drawer' />
		<div class='prose' set:html={content} />
		<AuthorBox />
	</article>
	{
		series && place ? (
			<UpNext
				label={
					next ? (crossing ? `On to the ${crossing.section.label}` : 'Next note') : 'Last note'
				}
				count={
					nextPlace &&
					(crossing
						? `Note ${nextPlace.index + 1} of ${nextPlace.section.parts.length}`
						: noteLabel(nextPlace))
				}
				href={next ? `/blog/${next.id}/` : `/series/${series.slug}/`}
				title={next ? next.data.title : series.title}
				text={next ? next.data.description : series.about}
				go={
					next
						? crossing
							? `Start the ${crossing.section.label}`
							: 'Read the next note'
						: 'See all notes'
				}
				back={
					prev
						? {
								href: `/blog/${prev.id}/`,
								label: `← ${place.prev ? 'Previous note' : `Back to the ${place.prevHalf?.section.label ?? 'previous'}`}: ${prev.data.title}`
							}
						: { href: `/series/${series.slug}/`, label: `← All notes in ${series.name}` }
				}
			/>
		) : (
			next &&
			next.id !== post.id && (
				<UpNext
					label='Read next'
					href={`/blog/${next.id}/`}
					title={next.data.title}
					text={next.data.description}
					meta={isoDate(next.data.publishDate)}
					go='Read the article'
					image={next.data.coverImage}
					back={{ href: '/blog/', label: '← All writing' }}
				/>
			)
		)
	}
	<BalloonSurprise slot='after' />
</ShellLayout>

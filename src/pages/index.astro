---
import PageLayout from '../layouts/BaseLayout.astro'
import ProfileSidebar from '@/components/portfolio/ProfileSidebar.astro'
import SkillLayout from '@/components/SkillLayout.astro'
import Card from '@/components/Card.astro'
import PostPreview from '@/components/blog/PostPreview.astro'

import { getAllPosts, sortMDByDate, personSchema, websiteSchema, jsonLdScript } from '@/utils'
import { siteConfig } from '@/site-config'

const languages = ['Python', 'Java', 'C++', 'Dart']
const frontend = ['JavaScript', 'HTML', 'CSS', 'React', 'Tailwind CSS', 'Bootstrap', 'Vue.js']
const backend = [
	'PHP',
	'MySQL',
	'Node.js',
	'Express.js',
	'MongoDB',
	'Django',
	'Laravel',
	'Java Spring Boot'
]
const others = ['Git', 'Linux', 'AWS', 'Nginx']
const technologies = ['WordPress', 'Astro', 'Next.js', 'Gatsby', 'GraphQL', 'Stripe', 'Firebase']

const MAX_POSTS = 5
const allPosts = await getAllPosts()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
const projectPosts = allPosts
	.filter((p) => p.data.tags.includes('project'))
	.sort((a, b) => (a.data.homePageIdx ?? Infinity) - (b.data.homePageIdx ?? Infinity))

const homeDescription = `${siteConfig.author} is a ${siteConfig.bio.charAt(0).toLowerCase()}${siteConfig.bio.slice(1)}`
---

<PageLayout meta={{ title: 'Software Developer', description: homeDescription }} wide>
	<script type='application/ld+json' set:html={jsonLdScript(personSchema)} is:inline />
	<script type='application/ld+json' set:html={jsonLdScript(websiteSchema)} is:inline />

	<div class='homepage-grid'>
		<!-- Left column: sticky profile sidebar -->
		<aside class='homepage-sidebar'>
			<ProfileSidebar />
		</aside>

		<!-- Right column: scrollable content -->
		<div class='flex flex-col gap-y-10'>
			<!-- Featured Projects -->
			{
				projectPosts.length > 0 && (
					<section data-reveal>
						<h2 class='text-foreground mb-4 text-base font-semibold'>Featured Projects</h2>
						<div class='grid grid-cols-1 gap-4 sm:grid-cols-2'>
							{projectPosts.map((post, i) => (
								<a
									href={`/blog/${post.id}/`}
									class:list={[
										'project-card group border-surface-warm-border bg-surface-warm flex flex-col gap-y-2 rounded-xl border p-4 transition-all hover:border-accent-warm/50',
										i === 0 && 'sm:col-span-2'
									]}
								>
									<h3 class='text-foreground font-medium group-hover:text-accent-warm transition-colors'>
										{post.data.title}
									</h3>
									<p class='text-muted-foreground text-sm'>
										{post.data.description}
										<span class='text-muted-foreground ml-1 inline'>→</span>
									</p>
								</a>
							))}
						</div>
					</section>
				)
			}

			<!-- Skills -->
			<section data-reveal>
				<h2 class='text-foreground mb-4 text-base font-semibold'>Skills</h2>
				<div class='flex flex-col gap-y-4'>
					<SkillLayout title='Languages' skills={languages} />
					<SkillLayout title='Frontend' skills={frontend} />
					<SkillLayout title='Backend' skills={backend} />
					<SkillLayout title='Technologies' skills={technologies} />
					<SkillLayout title='Others' skills={others} />
				</div>
			</section>

			<!-- Experience + Education -->
			<div class='grid grid-cols-1 gap-6 md:grid-cols-2' data-reveal>
				<section class='flex flex-col'>
					<h2 class='text-foreground mb-3 text-base font-semibold'>Experience</h2>
					<Card
						heading='Freelance Web Developer'
						subheading='Remote clients'
						date='2019 - Present'
					>
						<ul class='text-muted-foreground ml-4 list-disc'>
							<li>
								WordPress sites for small businesses - hosting, domains, email setup, and redesigns.
							</li>
							<li>
								Security work: malware cleanup, patching vulnerabilities, hardening compromised sites.
							</li>
							<li>Infrastructure migrations - moving DNS, email routing, and CDN across providers.</li>
						</ul>
					</Card>
				</section>

				<section class='flex flex-col'>
					<h2 class='text-foreground mb-3 text-base font-semibold'>Education</h2>
					<Card
						heading='BRAC University'
						subheading='BSc. in Computer Science and Engineering'
					>
						<ul class='text-muted-foreground ml-4 list-disc'>
							<li>
								Completed core courses including Data Structures, Algorithms, Discrete Mathematics,
								Digital Logic Design, Data Communications, Operating Systems, and Database Systems.
							</li>
							<li>
								Advanced coursework in Artificial Intelligence, Neural Networks, Compiler Design,
								Computer Architecture, Computer Networks, and Software Engineering.
							</li>
						</ul>
					</Card>
				</section>
			</div>

			<!-- Recent Posts -->
			{
				allPostsByDate.length > 0 && (
					<section data-reveal>
						<h2 class='text-foreground mb-4 text-base font-semibold'>Recent Posts</h2>
						<ul class='flex flex-col gap-y-2'>
							{allPostsByDate.map((p) => (
								<PostPreview post={p} />
							))}
						</ul>
						<a
							href='/blog/'
							class='text-foreground/75 hover:text-foreground mt-2 inline-flex w-fit items-center gap-x-1 font-medium transition-colors'
						>
							See all blog posts <span aria-hidden='true'>→</span>
						</a>
					</section>
				)
			}
		</div>
	</div>

	<script>
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.classList.add('section-reveal')
						observer.unobserve(e.target)
					}
				})
			},
			{ threshold: 0.1 }
		)
		document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el))
	</script>
</PageLayout>

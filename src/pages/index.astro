---
import PageLayout from '@/layouts/BaseLayout.astro'
import IdentityRail from '@/components/portfolio/IdentityRail.astro'
import ProjectRow from '@/components/project/ProjectRow.astro'

import { getAllProjects, personSchema, websiteSchema, jsonLdScript } from '@/utils'
import { siteConfig } from '@/site-config'

const skills = [
	{ category: 'Languages', items: ['Python', 'Java', 'C++', 'Dart'] },
	{
		category: 'Frontend',
		items: ['JavaScript', 'HTML', 'CSS', 'React', 'Tailwind CSS', 'Bootstrap']
	},
	{
		category: 'Backend',
		items: ['PHP', 'MySQL', 'Node.js', 'Express.js', 'MongoDB', 'FastAPI']
	},
	{
		category: 'Technologies',
		items: ['WordPress', 'Astro', 'Gatsby', 'GraphQL', 'Stripe', 'Firebase']
	},
	{ category: 'Others', items: ['Git', 'Linux', 'AWS', 'Nginx'] }
]

// Already in homepage order (homePageIdx, then newest); don't re-sort.
const projects = await getAllProjects()

const homeDescription = `${siteConfig.author} is a ${siteConfig.bio.charAt(0).toLowerCase()}${siteConfig.bio.slice(1)}`
---

<PageLayout meta={{ title: 'Software Developer', description: homeDescription }}>
	<script type='application/ld+json' set:html={jsonLdScript(personSchema)} is:inline />
	<script type='application/ld+json' set:html={jsonLdScript(websiteSchema)} is:inline />

	<div class='container page'>
		<div class='split'>
			<IdentityRail />
			<div class='stack'>
				{
					projects.length > 0 && (
						<section id='work' aria-labelledby='work-h'>
							<h2 class='h2 section-title' id='work-h'>
								Featured projects
							</h2>
							{projects.map((project) => (
								<ProjectRow project={project} />
							))}
						</section>
					)
				}
				<section id='experience' aria-labelledby='exp-h'>
					<h2 class='h2 section-title' id='exp-h'>Experience</h2>
					<div class='ledger-row'>
						<span class='meta when'>2019 - Present</span>
						<div>
							<h3 class='h3'>Freelance Web Developer</h3>
							<p class='org'>Remote clients</p>
							<ul>
								<li>
									WordPress sites for small businesses - hosting, domains, email setup, and
									redesigns.
								</li>
								<li>
									Security work: malware cleanup, patching vulnerabilities, hardening compromised
									sites.
								</li>
								<li>
									Infrastructure migrations - moving DNS, email routing, and CDN across providers.
								</li>
							</ul>
						</div>
					</div>
				</section>
				<section id='education' aria-labelledby='edu-h'>
					<h2 class='h2 section-title' id='edu-h'>Education</h2>
					<div class='ledger-row'>
						<span class='meta when'></span>
						<div>
							<h3 class='h3'>BRAC University</h3>
							<p class='org'>BSc. in Computer Science and Engineering</p>
							<ul>
								<li>
									Completed core courses including Data Structures, Algorithms, Discrete
									Mathematics, Digital Logic Design, Data Communications, Operating Systems, and
									Database Systems.
								</li>
								<li>
									Advanced coursework in Artificial Intelligence, Neural Networks, Compiler Design,
									Computer Architecture, Computer Networks, and Software Engineering.
								</li>
							</ul>
						</div>
					</div>
				</section>
				<section id='skills' aria-labelledby='skills-h'>
					<h2 class='h2 section-title' id='skills-h'>Skills</h2>
					<dl class='skills'>
						{
							skills.map(({ category, items }) => (
								<div>
									<dt>{category}</dt>
									<dd>{items.join(', ')}</dd>
								</div>
							))
						}
					</dl>
				</section>
			</div>
		</div>
	</div>
</PageLayout>

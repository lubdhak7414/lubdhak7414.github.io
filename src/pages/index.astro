---
import ShellLayout from '@/layouts/ShellLayout.astro'
import PostRow from '@/components/blog/PostRow.astro'
import WorkRow from '@/components/project/WorkRow.astro'

import {
	getAllPosts,
	getAllProjects,
	jsonLdScript,
	personSchema,
	sortByPublishDate,
	websiteSchema
} from '@/utils'
import { siteConfig } from '@/site-config'

// Already in homepage order (homePageIdx, then newest); don't re-sort.
const projects = await getAllProjects()
const posts = sortByPublishDate(await getAllPosts())
const latest = posts.slice(0, 4)

const homeDescription = `${siteConfig.author}: ${siteConfig.bio}`
---

<ShellLayout meta={{ title: 'Software Developer', description: homeDescription }} page='home'>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(personSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(websiteSchema)} is:inline />
	</Fragment>

	{
		projects.length > 0 && (
			<section id='work' aria-labelledby='work-h'>
				<div class='sec'>
					<h2 id='work-h'>Projects</h2>
					<span class='sec-note'>{`${projects.length} projects`}</span>
				</div>
				<ul class='prows'>
					{projects.map((project) => (
						<WorkRow project={project} />
					))}
				</ul>
			</section>
		)
	}
	{
		latest.length > 0 && (
			<section id='writing' aria-labelledby='writing-h'>
				<div class='sec'>
					<h2 id='writing-h'>Writing</h2>
					<a class='sec-note' href='/blog/'>
						All {posts.length} posts →
					</a>
				</div>
				<ul class='rows'>
					{latest.map((post) => (
						<PostRow entry={post} />
					))}
				</ul>
			</section>
		)
	}
</ShellLayout>

---
import ShellLayout from '@/layouts/ShellLayout.astro'
import HelpRows from '@/components/about/HelpRows.astro'
import ContactCard from '@/components/about/ContactCard.astro'

const meta = {
	description:
		'Contact Safwan Usaid Lubdhak: web applications, websites, security fixes and migrations for small businesses. Email hello@saf1.me.',
	title: 'Contact'
}
---

{
	/* For clients: how to reach me first (the address on the first screen at every width), then
what I can help with (each with proof on the site). */
}
<ShellLayout meta={meta} page='contact'>
	<header class='page-head'>
		<h1>Contact</h1>
	</header>
	<section aria-labelledby='reach-h'>
		<div class='sec'><h2 id='reach-h'>Get in touch</h2></div>
		<ContactCard />
	</section>
	<section aria-labelledby='help-h'>
		<div class='sec'><h2 id='help-h'>What I can help with</h2></div>
		<HelpRows />
		<p class='contact-about'>
			My experience and education are on the <a href='/about/'>About</a> page.
		</p>
	</section>
</ShellLayout>

<style>
	.contact-about {
		margin-top: 1.25rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--muted);
	}
	.contact-about a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: var(--accent-line);
		transition: text-decoration-color 0.15s ease;
	}
	.contact-about a:hover {
		text-decoration-color: currentColor;
	}
</style>

---
import ShellLayout from '@/layouts/ShellLayout.astro'
import PostRow from '@/components/blog/PostRow.astro'
import SeriesRow from '@/components/blog/SeriesRow.astro'
import { getAllPosts, sortByPublishDate, writingItems } from '@/utils'

const meta = {
	description: 'Articles on web development, WordPress, SEO, and projects by Safwan Usaid Lubdhak.',
	title: 'Writing'
}

const posts = writingItems(sortByPublishDate(await getAllPosts()))
const dateOf = (item: (typeof posts)[number]) =>
	(item.kind === 'series' ? item.series.parts[0]! : item.entry).data.publishDate

// Group by the year of the original publish date, newest year first.
const years = [...new Set(posts.map((item) => dateOf(item).getFullYear()))]
const byYear = years.map((year) => ({
	year,
	posts: posts.filter((item) => dateOf(item).getFullYear() === year)
}))
---

<ShellLayout meta={meta} page='writing'>
	<header class='page-head'>
		<h1>Writing</h1>
		<p class='page-note'>
			{posts.length} posts · <a href='/rss.xml' data-astro-reload data-astro-prefetch='false'
				>RSS feed</a
			> · Built things have <a href='/projects/'>their own page</a>
		</p>
	</header>
	<div id='posts'>
		{posts.length === 0 && <p class='empty'>No posts yet.</p>}
		{
			byYear.map(({ year, posts }) => (
				<section class='year' aria-labelledby={`year-${year}`}>
					<h2 id={`year-${year}`} class='label'>
						{year}
					</h2>
					<ul class='rows'>
						{posts.map((item) =>
							item.kind === 'series' ? (
								<SeriesRow series={item.series} />
							) : (
								<PostRow entry={item.entry} />
							)
						)}
					</ul>
				</section>
			))
		}
	</div>
</ShellLayout>

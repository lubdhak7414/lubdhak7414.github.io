---
import PageLayout from '@/layouts/BaseLayout.astro'
import { jsonLdScript } from '@/utils'
import { excuses } from '../data/excuses'

const meta = {
	description: 'Page not found',
	title: '404',
	noIndex: true
}
---

<PageLayout meta={meta}>
	<div class='container page'>
		<header class='p-header'>
			<p class='meta'>404</p>
			<h1 class='display'>This page pulled a disappearing act.</h1>
		</header>

		{/* terminal-style excuse generator */}
		<div class='code max-w-xl'>
			<div class='code-head'><span>bash - why-this-happened</span></div>
			<div class='px-4 py-4 font-mono text-[13px] leading-[1.65]'>
				<p class='text-muted'><span class='text-pine'>$</span> git blame this-page</p>
				<p id='excuse' aria-live='polite' class='mt-2 min-h-[3.3em]'>
					{excuses[0]}
				</p>
			</div>
		</div>

		<div class='mt-6 flex flex-wrap items-center gap-x-6 gap-y-4'>
			<a class='btn' href='/'>Take me home</a>
			<button id='roll-excuse' type='button' class='link text-sm'>Roll another excuse</button>
		</div>

		<p class='muted mt-6 text-sm'>
			…or go read the <a href='/blog/' class='link'>blog</a> instead.
		</p>
	</div>

	<script is:inline type='application/json' id='excuses-data' set:html={jsonLdScript(excuses)} />

	<script is:inline>
		const dataEl = document.getElementById('excuses-data')
		const excuses = dataEl ? JSON.parse(dataEl.textContent) : []

		const excuseEl = document.getElementById('excuse')
		const rollBtn = document.getElementById('roll-excuse')
		let current = 0

		function roll() {
			if (!excuseEl) return
			let next = current
			while (next === current && excuses.length > 1) {
				next = Math.floor(Math.random() * excuses.length)
			}
			current = next
			excuseEl.textContent = excuses[next]
		}

		rollBtn?.addEventListener('click', roll)
		roll()
	</script>
</PageLayout>

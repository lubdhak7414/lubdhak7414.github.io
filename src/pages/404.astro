---
import ShellLayout from '@/layouts/ShellLayout.astro'
import { jsonLdScript } from '@/utils'
import { excuses } from '../data/excuses'

const meta = {
	description: 'Page not found',
	title: '404',
	noIndex: true
}
---

<ShellLayout meta={meta} page='error'>
	<header class='page-head'>
		<p class='label'>404 · Page not found</p>
		<h1>This page pulled a disappearing act.</h1>
	</header>

	{/* terminal-style excuse generator */}
	<div class='terminal'>
		<p class='terminal-head'>bash - why-this-happened</p>
		<p class='terminal-cmd'><span>$</span> git blame this-page</p>
		<p id='excuse' aria-live='polite'>{excuses[0]}</p>
	</div>

	<p class='actions'>
		<a class='button' href='/'>Take me home</a>
		<button id='roll-excuse' type='button' class='text-button'>Roll another excuse</button>
	</p>
	<p class='page-note'>…or go read the <a href='/blog/'>blog</a> instead.</p>

	<script is:inline type='application/json' id='excuses-data' set:html={jsonLdScript(excuses)} />

	<script is:inline>
		;(() => {
			const dataEl = document.getElementById('excuses-data')
			const excuses = dataEl ? JSON.parse(dataEl.textContent) : []

			const excuseEl = document.getElementById('excuse')
			const rollBtn = document.getElementById('roll-excuse')
			let current = 0

			function roll() {
				if (!excuseEl) return
				let next = current
				while (next === current && excuses.length > 1) {
					next = Math.floor(Math.random() * excuses.length)
				}
				current = next
				excuseEl.textContent = excuses[next]
			}

			rollBtn?.addEventListener('click', roll)
			roll()
		})()
	</script>
</ShellLayout>

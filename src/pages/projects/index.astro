---
import ShellLayout from '@/layouts/ShellLayout.astro'
import WorkRow from '@/components/project/WorkRow.astro'
import { getAllProjects } from '@/utils'

const meta = {
	description: 'Projects by Safwan Usaid Lubdhak: software and websites.',
	title: 'Projects'
}

// Already in homepage order (homePageIdx, then newest); don't re-sort.
const projects = await getAllProjects()
---

<ShellLayout meta={meta} page='work'>
	<header class='page-head'>
		<h1>Projects</h1>
		<p class='page-note'>{`${projects.length} projects`}</p>
	</header>
	<ul class='prows'>
		{projects.map((project) => <WorkRow project={project} />)}
	</ul>
</ShellLayout>

---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { render } from 'astro:content'

import ProjectPage from '@/layouts/ProjectPage.astro'
import { getAllProjects } from '@/utils'

export const getStaticPaths = (async () => {
	const projects = await getAllProjects()
	// Prev/next follow the homepage order and wrap around, like the reference pager.
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: {
			project,
			prev: projects.length > 1 ? projects[(i - 1 + projects.length) % projects.length] : undefined,
			next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined
		}
	}))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { project, prev, next } = Astro.props
const { Content } = await render(project)
---

<ProjectPage project={project} prev={prev} next={next}>
	<Content />
</ProjectPage>

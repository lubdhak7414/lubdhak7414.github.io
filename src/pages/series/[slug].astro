---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'

import ShellLayout from '@/layouts/ShellLayout.astro'
import { getAllPosts, getSeries, isoDate, jsonLdScript } from '@/utils'
import { tidyTitle } from '@/utils/series'
import { typeset } from '@/utils/typeset'
import { siteConfig } from '@/site-config'

export const getStaticPaths = (async () => {
	return getSeries(await getAllPosts()).map((series) => ({
		params: { slug: series.slug },
		props: { series }
	}))
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { series } = Astro.props
const first = series.parts[0]!
const url = new URL(`/series/${series.slug}/`, Astro.site ?? siteConfig.url).href
const origin = new URL('/', Astro.site ?? siteConfig.url).href
// The id of a half's list, the target of the jump links at the top.
const anchor = (label: string) => (label ? label.toLowerCase() : 'notes')

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		'@id': `${url}#page`,
		url,
		name: series.title,
		description: series.about,
		inLanguage: siteConfig.lang,
		author: { '@id': `${origin}#person` },
		mainEntity: {
			'@type': 'ItemList',
			numberOfItems: series.parts.length,
			itemListElement: series.parts.map((part, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				url: new URL(`/blog/${part.id}/`, origin).href,
				name: part.data.title
			}))
		}
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: origin },
			{ '@type': 'ListItem', position: 2, name: 'Writing', item: new URL('/blog/', origin).href },
			{ '@type': 'ListItem', position: 3, name: series.title, item: url }
		]
	}
]
---

<ShellLayout meta={{ title: series.title, description: series.about }} page='writing'>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(schema)} is:inline />
	</Fragment>
	<header class='page-head series-head'>
		<p class='label'><a href='/blog/'>Writing</a> · course notes</p>
		<h1 set:text={tidyTitle(series.title)} />
		<p class='doc-lede' set:text={typeset(series.about)} />
		<p class='series-count'>
			<span set:text={`${series.parts.length} notes · ${isoDate(first.data.publishDate)}`} />
			{
				series.sections.length > 1 && (
					<span class='series-jump'>
						{series.sections.map((section) => (
							<a
								href={`#${anchor(section.label)}`}
								set:text={`${section.label} (${section.parts.length})`}
							/>
						))}
					</span>
				)
			}
		</p>
	</header>

	{
		series.sections.map((section) => (
			<section class='year' aria-labelledby={anchor(section.label)}>
				<h2 id={anchor(section.label)} class='label'>
					{section.label ? `${section.label} · ${section.parts.length} notes` : 'Notes'}
				</h2>
				<ol class='rows series-rows'>
					{section.parts.map((part, i) => (
						<li class='row'>
							<a class='row-link' href={`/blog/${part.id}/`}>
								<span class='row-date'>{`Note ${String(i + 1).padStart(2, '0')}`}</span>
								<span class='row-body'>
									<span
										class='row-title'
										set:text={`${part.data.draft ? '(Draft) ' : ''}${tidyTitle(part.data.title)}`}
									/>
									<span class='row-text' set:text={typeset(part.data.description)} />
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		))
	}

	<div class='prose series-intro'>
		<h2 id='about-these-notes'>About these notes</h2>
		<p>
			CSE 425 is the neural networks course in the computer science and engineering programme at
			BRAC University. I wrote these notes while taking it in Spring 2026. Each one covers a single
			topic, so you can follow every step with a pencil and check your own answer against mine.
		</p>
		<p>
			They are study notes from one student, not the official course material. If your lecturer’s
			notation or method differs from mine, go with your lecturer’s. If you are not at BRAC
			University, the topics are the standard ones for a first course in neural networks, and the
			notes stand on their own.
		</p>
		<h2 id='how-to-use-these-notes'>How to use these notes</h2>
		<p>
			Start with the maths primer for the half you are studying, then go in order: each note builds
			on the one before it, and the links inside them point back to the earlier ideas. Each half
			ends with an exam clinic that pulls the methods together on practice questions.
		</p>
		<h2 id='what-the-mid-covers'>What the Mid covers</h2>
		<p>
			The Mid runs from the single perceptron through multilayer networks, activation functions,
			backpropagation and computation graphs, then batch normalization, optimization and dropout,
			and finishes with recurrent networks: RNNs, backpropagation through time, the LSTM and the
			GRU.
		</p>
		<h2 id='what-the-final-covers'>What the Final covers</h2>
		<p>
			The Final covers convolutional networks (kernels, stride, padding, pooling and
			backpropagation), autoencoders, variational autoencoders with the reparameterization trick and
			the ELBO, attention and the transformer, graph neural networks, and Kohonen self-organizing
			maps.
		</p>
	</div>
</ShellLayout>

---
import ShellLayout from '@/layouts/ShellLayout.astro'
import ContactList from '@/components/layout/ContactList.astro'
import { jsonLdScript, personSchema } from '@/utils'
import { siteConfig } from '@/site-config'

const skills = [
	{ category: 'Languages', items: ['Python', 'Java', 'C++', 'Dart'] },
	{
		category: 'Frontend',
		items: ['JavaScript', 'HTML', 'CSS', 'React', 'Tailwind CSS', 'Bootstrap']
	},
	{
		category: 'Backend',
		items: ['PHP', 'MySQL', 'Node.js', 'Express.js', 'MongoDB', 'FastAPI']
	},
	{
		category: 'Technologies',
		items: ['WordPress', 'Astro', 'Gatsby', 'GraphQL', 'Stripe', 'Firebase']
	},
	{ category: 'Others', items: ['Git', 'Linux', 'AWS', 'Nginx'] }
]

const aboutDescription =
	'About Safwan Usaid Lubdhak - builds web apps, scales DevOps pipelines, and integrates AI systems.'

// AboutPage wrapper pointing at the canonical Person entity (shared `@id`).
const aboutPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	url: `${siteConfig.url}/about/`,
	mainEntity: { '@id': personSchema['@id'] }
}
---

<ShellLayout meta={{ title: 'About', description: aboutDescription }} page='about'>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(personSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(aboutPageSchema)} is:inline />
	</Fragment>

	<section aria-labelledby='do-h'>
		<div class='sec'><h2 id='do-h'>What I do</h2></div>
		<div class='text'>
			<p>
				I'm Safwan, a CS graduate from Bangladesh. I build web apps, scale DevOps pipelines, and
				integrate AI systems. I'm deeply passionate about the open-source ecosystem, regularly
				writing scripts and tools to customize the Linux desktop experience and optimize self-hosted
				environments.
			</p>
		</div>
	</section>
	<section aria-labelledby='os-h'>
		<div class='sec'><h2 id='os-h'>Open source</h2></div>
		<div class='text'>
			<p>
				Most of my projects are public. I write about what I'm working on in the blog here, and the
				source is on <a href={siteConfig.socials.github} target='_blank' rel='noopener noreferrer'
					>GitHub</a
				>.
			</p>
		</div>
	</section>
	<section aria-labelledby='ct-h'>
		<div class='sec'><h2 id='ct-h'>Elsewhere &amp; contact</h2></div>
		<ContactList />
		<div class='text'>
			<p>
				Want to see what I've built? Read the <a href='/blog/'>blog</a> for write-ups, or head back to
				the <a href='/'>homepage</a> for the case studies.
			</p>
		</div>
	</section>
	<section id='background' aria-labelledby='background-h'>
		<div class='sec'>
			<h2 id='background-h'>Background</h2>
		</div>
		<ul class='rows'>
			<li class='row'>
				<div class='row-static'>
					<span class='row-date'>2019 - now</span>
					<div class='row-body'>
						<h3 class='row-title'>Freelance Web Developer</h3>
						<p class='row-text'>Remote clients</p>
						<ul class='dots'>
							<li>
								WordPress sites for small businesses - hosting, domains, email setup, and redesigns.
							</li>
							<li>
								Security work: malware cleanup, patching vulnerabilities, hardening compromised
								sites.
							</li>
							<li>
								Infrastructure migrations - moving DNS, email routing, and CDN across providers.
							</li>
						</ul>
					</div>
				</div>
			</li>
			<li class='row'>
				<div class='row-static'>
					<span class='row-date'>BSc</span>
					<div class='row-body'>
						<h3 class='row-title'>BRAC University</h3>
						<p class='row-text'>BSc. in Computer Science and Engineering</p>
						<ul class='dots'>
							<li>
								Completed core courses including Data Structures, Algorithms, Discrete Mathematics,
								Digital Logic Design, Data Communications, Operating Systems, and Database Systems.
							</li>
							<li>
								Advanced coursework in Artificial Intelligence, Neural Networks, Compiler Design,
								Computer Architecture, Computer Networks, and Software Engineering.
							</li>
						</ul>
					</div>
				</div>
			</li>
		</ul>
		<dl class='skills'>
			{
				skills.map(({ category, items }) => (
					<div>
						<dt>{category}</dt>
						<dd>{items.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</section>
</ShellLayout>

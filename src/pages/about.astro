---
import ShellLayout from '@/layouts/ShellLayout.astro'
import { getAllPosts, getAllProjects, jsonLdScript, personSchema } from '@/utils'
import { entryHref, type Entry } from '@/utils/post'
import { siteConfig } from '@/site-config'

const skills = [
	{ category: 'Languages', items: ['Python', 'Java', 'C++', 'Dart'] },
	{
		category: 'Frontend',
		items: ['JavaScript', 'HTML', 'CSS', 'React', 'Tailwind CSS', 'Bootstrap']
	},
	{
		category: 'Backend',
		items: ['PHP', 'MySQL', 'Node.js', 'Express.js', 'MongoDB', 'FastAPI']
	},
	{
		category: 'Technologies',
		items: ['WordPress', 'Astro', 'Gatsby', 'GraphQL', 'Stripe', 'Firebase']
	},
	{ category: 'Others', items: ['Git', 'Linux', 'AWS', 'Nginx'] }
]

const aboutDescription =
	'About Safwan Usaid Lubdhak: software developer at Metaora and recent CS graduate. Experience, education and skills.'

// Freelance work on the site, shown under the freelance row (a missing id or a draft drops out).
const [projects, posts] = await Promise.all([getAllProjects(), getAllPosts()])
const freelance = [
	projects.find((entry) => entry.id === 'green-bangla-foundation'),
	projects.find((entry) => entry.id === 'ni-driving-test-routes'),
	posts.find((entry) => entry.id === 'wordpress-css-rootkit')
].filter((entry): entry is Entry => Boolean(entry))
const label = (entry: Entry) =>
	entry.collection === 'project' ? (entry.data.name ?? entry.data.title) : entry.data.title

// AboutPage wrapper pointing at the canonical Person entity (shared `@id`).
const aboutPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	url: `${siteConfig.url}/about/`,
	mainEntity: { '@id': personSchema['@id'] }
}
---

<ShellLayout meta={{ title: 'About', description: aboutDescription }} page='about'>
	<Fragment slot='head'>
		<script type='application/ld+json' set:html={jsonLdScript(personSchema)} is:inline />
		<script type='application/ld+json' set:html={jsonLdScript(aboutPageSchema)} is:inline />
	</Fragment>

	<section aria-labelledby='do-h'>
		<div class='sec'><h2 id='do-h'>What I do</h2></div>
		<div class='text'>
			<p>
				I'm a software developer in Dhaka. I work on web apps at Metaora, a software company in
				Atlanta, and since 2019 I've built and fixed WordPress sites for small businesses. Outside
				work I write small open-source tools for the Linux desktop.
			</p>
		</div>
	</section>
	<section id='background' aria-labelledby='background-h'>
		<div class='sec'>
			<h2 id='background-h'>Background</h2>
		</div>
		<ul class='rows'>
			<li class='row'>
				<div class='row-static'>
					<span class='row-date'>2026 - now</span>
					<div class='row-body'>
						<h3 class='row-title'>Software Engineering Intern</h3>
						<p class='row-text'>Metaora, Atlanta (remote)</p>
						<ul class='dots'>
							<li>Working on features and fixes in the company's web app and website.</li>
							<li>Testing changes before release and writing clear bug reports.</li>
							<li>Working through code review with the engineering lead.</li>
						</ul>
					</div>
				</div>
			</li>
			<li class='row'>
				<div class='row-static'>
					<span class='row-date'>2019 - now</span>
					<div class='row-body'>
						<h3 class='row-title'>Freelance Web Developer</h3>
						<p class='row-text'>Remote clients</p>
						<ul class='dots'>
							<li>
								WordPress sites for small businesses - hosting, domains, email setup, and redesigns.
							</li>
							<li>
								Security work: malware cleanup, patching vulnerabilities, hardening compromised
								sites.
							</li>
							<li>
								Infrastructure migrations - moving DNS, email routing, and CDN across providers.
							</li>
						</ul>
						{
							freelance.length > 0 && (
								<p class='row-proof'>
									<span class='row-see'>see</span>
									<span class='row-links'>
										{freelance.map((entry) => (
											<a href={entryHref(entry)} set:text={label(entry)} />
										))}
									</span>
								</p>
							)
						}
					</div>
				</div>
			</li>
			<li class='row'>
				<div class='row-static'>
					<span class='row-date'>BSc</span>
					<div class='row-body'>
						<h3 class='row-title'>BRAC University</h3>
						<p class='row-text'>BSc. in Computer Science and Engineering</p>
						<ul class='dots'>
							<li>
								Completed core courses including Data Structures, Algorithms, Discrete Mathematics,
								Digital Logic Design, Data Communications, Operating Systems, and Database Systems.
							</li>
							<li>
								Advanced coursework in Artificial Intelligence, Neural Networks, Compiler Design,
								Computer Architecture, Computer Networks, and Software Engineering.
							</li>
						</ul>
					</div>
				</div>
			</li>
		</ul>
		<dl class='skills'>
			{
				skills.map(({ category, items }) => (
					<div>
						<dt>{category}</dt>
						<dd>{items.join(', ')}</dd>
					</div>
				))
			}
		</dl>
	</section>
	<section aria-labelledby='os-h'>
		<div class='sec'><h2 id='os-h'>Open source</h2></div>
		<div class='text'>
			<p>
				Most of my projects are public. I write about what I'm working on in the blog here, and the
				source is on <a href={siteConfig.socials.github} target='_blank' rel='noopener noreferrer'
					>GitHub</a
				>.
			</p>
			<p>
				Want to see what I've built? See <a href='/projects/'>Projects</a>, or
				<a href='/blog/'>Writing</a> for the write-ups.
			</p>
		</div>
	</section>
	<p class='about-tools'>
		<a href='/tools/'>The tools I use day to day <span aria-hidden='true'>→</span></a>
	</p>
</ShellLayout>

<style>
	.row-proof {
		display: flex;
		gap: 0.75rem;
		margin-top: 0.625rem;
		font-size: 0.875rem;
		line-height: 1.5;
	}
	.row-see {
		flex: none;
		font: 400 0.75rem/1.75 var(--mono);
		color: var(--faint);
	}
	.row-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	.row-links a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: var(--accent-line);
	}
	.row-links a:hover {
		text-decoration-color: currentColor;
	}
	.about-tools {
		margin-top: 3rem;
		font: 400 0.8125rem/1.6 var(--mono);
	}
	.about-tools a {
		display: inline-block;
		padding-block: 0.5rem;
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: var(--accent-line);
		transition: text-decoration-color 0.15s ease;
	}
	.about-tools a:hover {
		text-decoration-color: currentColor;
	}
</style>

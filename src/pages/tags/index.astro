---
import PageLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts, getAllProjects, getUniqueTagsWithCount, slugifyTag } from '@/utils'

const posts = await getAllPosts()
const projects = await getAllProjects()
const allTags = getUniqueTagsWithCount([...posts, ...projects])

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`
const countLabel = (tag: string) =>
	[
		[posts.filter((p) => p.data.tags.includes(tag)).length, 'post'] as const,
		[projects.filter((p) => p.data.tags.includes(tag)).length, 'project'] as const
	]
		.filter(([n]) => n > 0)
		.map(([n, word]) => plural(n, word))
		.join(' / ')

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: 'All Tags'
}
---

<PageLayout meta={meta}>
	<div class='container page'>
		<a class='back' href='/blog/'>← All posts</a>
		<header class='intro'>
			<h1 class='display'>Tags</h1>
		</header>
		{allTags.length === 0 && <p class='empty'>No posts yet.</p>}
		{
			allTags.map(([tag]) => (
				<a class='repo' href={`/tags/${slugifyTag(tag)}/`}>
					<h2 class='h3'>#{tag}</h2>
					<p class='meta'>{countLabel(tag)}</p>
				</a>
			))
		}
	</div>
</PageLayout>

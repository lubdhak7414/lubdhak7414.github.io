---
import type { GetStaticPaths, Page } from 'astro'

import Pagination from '@/components/Paginator.astro'
import FormattedDate from '@/components/FormattedDate.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import {
	getAllPosts,
	getAllProjects,
	entryHref,
	getUniqueTags,
	slugifyTag,
	sortByPublishDate,
	jsonLdScript
} from '@/utils'
import type { Entry } from '@/utils'
import { siteConfig } from '@/site-config'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	// Tags span both content types, so a tag page lists posts and projects together.
	const allPosts: Entry[] = [...(await getAllPosts()), ...(await getAllProjects())]
	const allPostsByDate = sortByPublishDate(allPosts)
	const uniqueTags = getUniqueTags(allPostsByDate)

	// Fail loudly if two distinct tags slugify to the same value - otherwise
	// `paginate` would emit duplicate static paths and the build crashes with an
	// opaque error. A named tag pair is far easier to act on.
	const slugOwner = new Map<string, string>()
	for (const tag of uniqueTags) {
		const slug = slugifyTag(tag)
		const owner = slugOwner.get(slug)
		if (owner && owner !== tag) {
			throw new Error(
				`Tag slug collision: "${owner}" and "${tag}" both slugify to "${slug}". Rename one tag.`
			)
		}
		slugOwner.set(slug, tag)
	}

	return uniqueTags.flatMap((tag) => {
		const filterPosts = allPostsByDate.filter((post) => post.data.tags.includes(tag))
		return paginate(filterPosts, {
			pageSize: 10,
			// URL uses the slug; the human-readable tag is passed through props.
			params: { tag: slugifyTag(tag) },
			props: { tag }
		})
	})
}

interface Props {
	page: Page<Entry>
	tag: string
}

const { page, tag } = Astro.props

const meta = {
	description: `Articles and project write-ups tagged ${tag} by ${siteConfig.author}.`,
	title: `Tag: ${tag}`
}

const tagUrl = new URL(`/tags/${Astro.params.tag}/`, Astro.site).toString()
const collectionPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Posts tagged #${tag}`,
	url: tagUrl,
	description: `Articles and project write-ups tagged ${tag} by ${siteConfig.author}.`
}

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: `← Previous page`,
			url: page.url.prev
		}
	}),
	...(page.url.next && {
		nextUrl: {
			text: `Next page →`,
			url: page.url.next
		}
	})
}
---

<PageLayout meta={meta}>
	<script type='application/ld+json' set:html={jsonLdScript(collectionPageSchema)} is:inline />
	<div class='page container'>
		<a class='back' href='/tags/'>← All tags</a>
		<header class='front-head'>
			<p class='kicker'>Filed under</p>
			<h1 class='display'>{tag}</h1>
			<p class='meta'>{page.total} {page.total === 1 ? 'entry' : 'entries'}</p>
		</header>
		<section aria-label='Posts and projects with this tag'>
			{
				page.data.map((entry) => (
					<a class='post' href={entryHref(entry)}>
						<FormattedDate class='meta date' date={entry.data.publishDate} />
						<div>
							<h2 class='h3'>
								{entry.data.draft && '(Draft) '}
								{entry.data.title}
							</h2>
							<p>{entry.data.description}</p>
							<span class='meta'>{entry.collection === 'project' ? 'Project' : 'Blog post'}</span>
						</div>
					</a>
				))
			}
			<Pagination {...paginationProps} />
		</section>
	</div>
</PageLayout>
